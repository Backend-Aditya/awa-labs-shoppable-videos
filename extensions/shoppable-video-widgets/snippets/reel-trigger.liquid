{% doc %}
The clickable wrapper every widget puts around a reel: carries the viewer
settings as data attributes (read by reel-lightbox.js / reel-story.js when
the reel opens), the widget's own visual markup passed in as `inner`, and
the tagged products as a <template> the viewer clones from. Each block owns
its look; this snippet owns the contract with the JS.

@param reel {metaobject} - the reel metaobject
@param style {object} - the widget's style object from its shop metafield
@param inner {string} - the widget's own markup for this trigger (must contain a .awa-sv-trigger__button)
@param class {string} [optional] - extra classes for the wrapper
@param muted_default {boolean} - whether video starts muted when the merchant hasn't chosen
@param autoplay_default {boolean} [optional] - preview on when the merchant hasn't chosen
@param autoplay_preview {boolean} [optional] - force the inline muted preview on
@param source {string} [optional] - which widget this is, reported with its events (e.g. 'stories')
@param details_default {boolean} [optional] - open product details in the viewer when the merchant hasn't chosen
@param corners_default {string} [optional] - 'square' or 'rounded' popup corners when the merchant hasn't chosen
@param image_size_default {string} [optional] - 'compact' or 'large' product images in the viewer when the merchant hasn't chosen

@example
{% render 'reel-trigger', reel: reel, style: widget_style, inner: card, muted_default: true %}
{% enddoc %}
{%- liquid
  assign muted = muted_default
  if style.mutedDefault == true
    assign muted = true
  elsif style.mutedDefault == false
    assign muted = false
  endif

  assign show_title = true
  if style.showTitleOverlay == false
    assign show_title = false
  endif

  assign autoplay = false
  if autoplay_default
    assign autoplay = true
  endif
  if style.autoplayOnScroll == true
    assign autoplay = true
  elsif style.autoplayOnScroll == false
    assign autoplay = false
  endif
  if autoplay_preview
    assign autoplay = true
  endif

  assign product_details = false
  if details_default
    assign product_details = true
  endif
  if style.productDetails == true
    assign product_details = true
  elsif style.productDetails == false
    assign product_details = false
  endif
  assign image_size = style.productImageSize | default: image_size_default | default: 'compact'

  assign cta_hover = ''
  if style.ctaColor != blank
    assign cta_brightness = style.ctaColor | color_brightness
    if cta_brightness > 150
      assign cta_hover = style.ctaColor | color_darken: 10
    else
      assign cta_hover = style.ctaColor | color_lighten: 12
    endif
  endif
-%}
<div
  class="awa-sv-trigger {{ class }}"
  data-awa-sv-trigger
  data-reel-id="{{ reel.system.id }}"
  data-source="{{ source | escape }}"
  data-hls-src="{{ reel.config.value.hlsManifestUrl | escape }}"
  data-poster-url="{{ reel.config.value.posterUrl | escape }}"
  data-title="{{ reel.title.value | escape }}"
  data-cta-color="{{ style.ctaColor | escape }}"
  data-cta-text-color="{{ style.ctaTextColor | escape }}"
  data-cta-hover-color="{{ cta_hover | escape }}"
  data-cta-style="{{ style.ctaStyle | default: 'pill' | escape }}"
  data-show-title="{{ show_title }}"
  data-muted-default="{{ muted }}"
  data-loop="{% if style.loop %}true{% else %}false{% endif %}"
  data-play-trigger="{{ style.playTrigger | default: 'click' | escape }}"
  data-autoplay-scroll="{{ autoplay }}"
  data-story-duration="{{ style.storyDuration | default: 15 | times: 1000 | round }}"
  data-product-count="{{ reel.tagged_products.value.size | default: 0 }}"
  data-link-url="{{ reel.config.value.interactions.ctaUrl | escape }}"
  data-link-label="{{ reel.config.value.interactions.ctaLabel | default: '' | escape }}"
  data-show-share="{% if style.showShare == false %}false{% else %}true{% endif %}"
  data-show-recommendations="{% if style.showRecommendations == false %}false{% else %}true{% endif %}"
  data-after-add="{{ style.afterAdd | default: 'stay' | escape }}"
  data-product-details="{{ product_details }}"
  data-product-image-size="{{ image_size | escape }}"
  data-show-description="{% if style.showDescription == false %}false{% else %}true{% endif %}"
  data-viewer-nav="{% if style.viewerNav == 'stacked' %}stacked{% else %}sides{% endif %}"
  data-popup-corners="{{ style.popupCorners | default: corners_default | default: 'rounded' | escape }}"
  data-show-quantity="{% if style.showQuantity %}true{% else %}false{% endif %}"
  {%- if reel.config.value.productTimes %} data-product-times="{{ reel.config.value.productTimes | json | escape }}"{% endif %}
>
  {{- inner -}}
  {%- if reel.tagged_products.value.size > 0 -%}
    <template data-awa-sv-products>
      {%- render 'reel-product-card' for reel.tagged_products.value as product, style: style, image_size: image_size -%}
    </template>
    {%- comment -%} Without JS the trigger can't play; still let shoppers reach what's in the video. {%- endcomment -%}
    <noscript>
      <ul class="awa-sv-noscript">
        {%- for tagged in reel.tagged_products.value -%}
          <li><a href="{{ tagged.url }}">{{ tagged.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    </noscript>
  {%- endif -%}
</div>
