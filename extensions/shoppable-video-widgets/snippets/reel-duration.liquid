{% doc %}
A reel's length as a small m:ss chip over its poster. Renders nothing when
the reel has no duration yet (still processing on Cloudflare Stream).

@param reel {metaobject} - the reel metaobject
@param icon {boolean} [optional] - prefix a small play glyph

@example
{% render 'reel-duration', reel: reel, icon: true %}
{% enddoc %}
{%- assign total = reel.config.value.durationSeconds | round -%}
{%- if total > 0 -%}
  {%- assign minutes = total | divided_by: 60 -%}
  {%- assign seconds = total | modulo: 60 -%}
  <span class="reelup-chip">
    {%- if icon -%}
      {%- render 'reel-icon', name: 'play', size: 12 -%}
    {%- endif -%}
    <span class="reelup-visually-hidden">{{ 'reels.duration_label' | t }}</span>
    {{- minutes }}:{% if seconds < 10 %}0{% endif %}{{ seconds -}}
  </span>
{%- endif -%}
