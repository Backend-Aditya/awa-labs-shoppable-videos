{% doc %}
One shoppable product row: image, title, price (with compare-at), a variant
picker when the product has options, and a quick add button. Used inside
every reel's <template data-awa-sv-products> (cloned into the video viewer
and story drawer by JS) and rendered directly by the featured-video block's
inline product list. Click/change behaviour is delegated document-wide in
reel-lightbox.js, so the same markup works in all three places.

Products with more than 30 variants get a "Choose options" link to the
product page instead of a picker: the <select> would bloat every template
(each reel repeats it), and above 100 variants it couldn't list them all
anyway, adding a variant the shopper never chose would be wrong.

@param product {product} - the tagged product
@param style {object} - the widget's style object (showPrice, showProductImage, showSaleBadge, ctaLabel)
@param image_size {string} [optional] - 'large' renders a tile for the viewer's two-column grid: image, title,
  price and a "Shop now" link (no variant picker or add button; options and add to cart live in the
  product details view it opens)

@example
{% render 'reel-product-card' for reel.tagged_products.value as product, style: widget_style %}
{% enddoc %}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign show_price = true
  if style.showPrice == false
    assign show_price = false
  endif
  assign show_image = true
  if style.showProductImage == false
    assign show_image = false
  endif
  # The saving as a whole percent, rounded half up with integer maths
  # (Shopify's divided_by on integers floors): (saving × 100 + compare/2) / compare.
  assign show_badge = false
  if style.showSaleBadge == true and show_price
    assign show_badge = true
  endif
  assign add_label = 'reels.add_to_cart' | t
  if style.ctaLabel != blank
    assign add_label = style.ctaLabel | escape
  endif
  assign variant_count = product.variants_count | default: product.variants.size
  assign choose_on_page = false
  if variant_count > 30
    assign choose_on_page = true
  endif
  assign discount = 0
  if show_badge and choose_on_page == false and variant.compare_at_price > variant.price
    assign half = variant.compare_at_price | divided_by: 2
    assign discount = variant.compare_at_price | minus: variant.price | times: 100 | plus: half | divided_by: variant.compare_at_price
  endif
-%}
{%- assign tile = false -%}
{%- if image_size == 'large' -%}{%- assign tile = true -%}{%- endif -%}
{%- if variant -%}
<div class="awa-sv-product{% if tile %} awa-sv-product--tile{% endif %}" data-awa-sv-product data-product-id="{{ product.id }}" data-product-url="{{ product.url }}">
  {%- if show_image and product.featured_image -%}
    <a class="awa-sv-product__media" href="{{ product.url }}" data-awa-sv-product-link tabindex="-1" aria-hidden="true">
      {%- if image_size == 'large' -%}
        {%- assign image_ratio = product.featured_image.aspect_ratio | default: 1 -%}
        <img
          src="{{ product.featured_image | image_url: width: 400 }}"
          alt=""
          loading="lazy"
          width="200"
          height="{{ 200 | divided_by: image_ratio | round }}"
        >
      {%- else -%}
        <img
          src="{{ product.featured_image | image_url: width: 192 }}"
          alt=""
          loading="lazy"
          width="96"
          height="96"
        >
      {%- endif -%}
    </a>
  {%- endif -%}
  <div class="awa-sv-product__info">
    <a class="awa-sv-product__title" href="{{ product.url }}" data-awa-sv-product-link>{{ product.title | escape }}</a>
    {%- if show_price -%}
      <span class="awa-sv-product__price">
        <span data-awa-sv-price>
          {%- if choose_on_page and product.price_varies -%}
            {%- assign from_price = product.price_min | money_without_trailing_zeros | strip_html -%}
            {{ 'reels.price_from' | t: price: from_price }}
          {%- else -%}
            {{ variant.price | money }}
          {%- endif -%}
        </span>
        <s class="awa-sv-product__compare" data-awa-sv-compare{% unless variant.compare_at_price > variant.price and choose_on_page == false %} hidden{% endunless %}>
          {{- variant.compare_at_price | money -}}
        </s>
        {%- if show_badge -%}
          {%- comment -%} Both prices are already read out; the badge is visual. {%- endcomment -%}
          <span class="awa-sv-product__badge" data-awa-sv-badge aria-hidden="true"{% if discount == 0 %} hidden{% endif %}>−{{ discount }}%</span>
        {%- endif -%}
      </span>
    {%- endif -%}
    {%- unless product.has_only_default_variant or choose_on_page or tile -%}
      <select class="awa-sv-product__variant" data-awa-sv-variant aria-label="{{ 'reels.options_label' | t: product: product.title }}">
        {%- for option_variant in product.variants -%}
          <option
            value="{{ option_variant.id }}"
            data-price="{{ option_variant.price | money | escape }}"
            data-compare="{% if option_variant.compare_at_price > option_variant.price %}{{ option_variant.compare_at_price | money | escape }}{% endif %}"
            data-available="{{ option_variant.available }}"
            {%- if show_badge and option_variant.compare_at_price > option_variant.price %}
              {%- assign option_half = option_variant.compare_at_price | divided_by: 2 -%}
              {%- assign option_discount = option_variant.compare_at_price | minus: option_variant.price | times: 100 | plus: option_half | divided_by: option_variant.compare_at_price %} data-discount="{{ option_discount }}"
            {%- endif %}
            {%- if option_variant.featured_image %} data-image="{{ option_variant.featured_image | image_url: width: 192 }}"{% endif %}
            {% if option_variant.id == variant.id %}selected{% endif %}
          >
            {{- option_variant.title | escape -}}
            {%- unless option_variant.available %} · {{ 'reels.sold_out' | t }}{% endunless -%}
          </option>
        {%- endfor -%}
      </select>
    {%- endunless -%}
  </div>
  {%- if tile -%}
    {%- comment -%}
      Opens the product's details inside the viewer (reel-lightbox.js) when the widget turns
      that on, otherwise its page. Carries the add button's labels for the details view.
    {%- endcomment -%}
    <a
      class="awa-sv-product__shop"
      href="{{ product.url }}"
      data-awa-sv-product-link
      data-awa-sv-shop
      data-variant-id="{{ variant.id }}"
      data-add-label="{{ add_label }}"
      data-added-label="{{ 'reels.added_to_cart' | t }}"
      data-sold-out-label="{{ 'reels.sold_out' | t }}"
      aria-label="{{ 'reels.shop_now' | t }}: {{ product.title | escape }}"
    >
      {{- 'reels.shop_now' | t -}}
    </a>
  {%- elsif choose_on_page -%}
    <a class="awa-sv-product__add awa-sv-product__choose" href="{{ product.url }}" data-awa-sv-product-link>
      {{- 'reels.choose_options' | t -}}
    </a>
  {%- else -%}
    {%- if style.showQuantity -%}
      <div class="awa-sv-qty" data-awa-sv-qty>
        <button type="button" class="awa-sv-qty__step" data-awa-sv-qty-step="-1" aria-label="{{ 'reels.decrease_quantity' | t }}">&minus;</button>
        <input class="awa-sv-qty__input" data-awa-sv-qty-input type="number" inputmode="numeric" min="1" max="99" value="1" aria-label="{{ 'reels.quantity_label' | t }}">
        <button type="button" class="awa-sv-qty__step" data-awa-sv-qty-step="1" aria-label="{{ 'reels.increase_quantity' | t }}">+</button>
      </div>
    {%- endif -%}
    <button
      type="button"
      class="awa-sv-product__add"
      data-awa-sv-add-to-cart
      data-variant-id="{{ variant.id }}"
      data-add-label="{{ add_label }}"
      data-added-label="{{ 'reels.added_to_cart' | t }}"
      data-sold-out-label="{{ 'reels.sold_out' | t }}"
      {% unless variant.available %}disabled{% endunless %}
    >
      {%- if variant.available %}{{ add_label }}{% else %}{{ 'reels.sold_out' | t }}{% endif -%}
    </button>
  {%- endif -%}
</div>
{%- endif -%}
