{% doc %}
The widgets' inline icons, the same family as the viewer chrome in
reel-lightbox.js: 24px grid, round strokes, after Lucide (lucide.dev, ISC).
The play glyph stays solid, the shape shoppers read at a glance, and is the
viewer's exact path: a rounded triangle whose centre of mass is the grid's
centre, so it sits centred in a round badge without nudging.

@param name {string} - play | chevron-left | chevron-right | close
@param size {number} - rendered width and height in px
@param stroke {number} [optional] - stroke width on the 24px grid (default 2); thicker reads better at tiny sizes
@param class {string} [optional] - class for the <svg>

@example
{% render 'reel-icon', name: 'chevron-right', size: 16 %}
{% enddoc %}
{%- liquid
  assign stroke_width = stroke | default: 2
  case name
    when 'chevron-left'
      assign path = 'm15 18-6-6 6-6'
    when 'chevron-right'
      assign path = 'm9 18 6-6-6-6'
    when 'close'
      assign path = 'M18 6 6 18M6 6l12 12'
  endcase
-%}
{%- if name == 'play' -%}
  <svg{% if class != blank %} class="{{ class }}"{% endif %} width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8.25 6.85Q8.25 5.25 9.62 6.07L18.21 11.23Q19.5 12 18.21 12.77L9.62 17.93Q8.25 18.75 8.25 17.15Z"/></svg>
{%- elsif path -%}
  <svg{% if class != blank %} class="{{ class }}"{% endif %} width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke_width }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="{{ path }}"/></svg>
{%- endif -%}
