{% doc %}
PRODUCT_PAGE_REELS: a filmstrip of short clips under the product details —
9:16 posters with a length chip, the reel title, and the first tagged
product beneath each so shoppers see what's inside before they tap.
Opening a clip plays it in the shared viewer, with next/previous through
the rest of the strip. Settings live in the app's widget editor and reach
this block through the shop-level widget metafield.

@example
{% content_for 'block', type: 'product-page-reels', id: 'reels' %}
{% enddoc %}

{{ 'reel-widgets.css' | asset_url | stylesheet_tag }}

{% comment %}
  Literal namespace, not {% render 'reel-namespace' %}: the theme editor wraps
  rendered snippet output in BEGIN/END comments, which corrupts a captured
  string. Keep in sync with reel-namespace.liquid (checked by
  scripts/check-reel-namespace.mjs).
{% endcomment %}
{% assign reel_namespace = 'app--404281098241' %}

{%- liquid
  assign widget = shop.metafields[reel_namespace].product_page_reels_widget.value
  assign widget_style = widget.style
  assign reels = shop.metafields[reel_namespace].product_page_reels_widget_reels.value

  assign show_widget = false
  if widget.published
    case widget.targetRule.type
      when 'all_products'
        assign show_widget = true
      when 'handles'
        if product and widget.targetRule.handles contains product.handle
          assign show_widget = true
        endif
      when 'collections'
        for collection in product.collections
          if widget.targetRule.handles contains collection.handle
            assign show_widget = true
            break
          endif
        endfor
    endcase
  endif
  if widget.pageTypes.size > 0
    unless widget.pageTypes contains template.name
      assign show_widget = false
    endunless
  endif

  assign visible_count = 0
  if show_widget
    for reel in reels
      if reel.published.value and reel.config.value.hlsManifestUrl != blank
        assign visible_count = visible_count | plus: 1
      endif
    endfor
  endif

  assign layout = widget_style.layoutMode | default: 'carousel'
  if layout != 'grid'
    assign layout = 'carousel'
  endif

  assign show_caption = true
  if widget_style.showCaption == false
    assign show_caption = false
  endif
  assign show_duration = true
  if widget_style.showDuration == false
    assign show_duration = false
  endif
  assign show_product = true
  if widget_style.showProductPreview == false
    assign show_product = false
  endif
  assign show_price = true
  if widget_style.showPrice == false
    assign show_price = false
  endif

  case widget_style.cornerStyle
    when 'sharp'
      assign radius = '0px'
    when 'soft'
      assign radius = '18px'
    else
      assign radius = '10px'
  endcase
-%}

{%- if visible_count > 0 -%}
  {%- capture wrapper_style -%}
    --ru-radius: {{ radius }};
    --ru-card-width: {{ widget_style.triggerSize | default: 200 }}px;
    --ru-columns: {{ widget_style.columns | default: 4 }};
    {%- if widget_style.accentColor != blank %}--ru-accent: {{ widget_style.accentColor }};{% endif -%}
    {%- if widget_style.backgroundColor != blank %}--ru-bg: {{ widget_style.backgroundColor }};{% endif -%}
    {%- if widget_style.textColor != blank %}--ru-text: {{ widget_style.textColor }};{% endif -%}
  {%- endcapture -%}
  <section
    class="reelup reelup-strip reelup-strip--{{ layout }} reelup-shadow--{{ widget_style.shadowPreset | default: 'none' }} reelup-device--{{ widget.deviceVisibility | default: 'all' }}{% if widget_style.backgroundColor != blank %} reelup--filled{% endif %}"
    style="{{ wrapper_style | strip_newlines }}"
    {% if widget_style.heading != blank %}aria-label="{{ widget_style.heading | escape }}"{% endif %}
    {{ block.shopify_attributes }}
  >
    {%- if widget_style.heading != blank -%}
      <h2 class="reelup-heading">{{ widget_style.heading | escape }}</h2>
    {%- endif -%}
    <div class="reelup-strip__viewport">
      <ul class="reelup-strip__track" data-reelup-group data-reelup-strip role="list">
        {%- for reel in reels -%}
          {%- if reel.published.value and reel.config.value.hlsManifestUrl != blank -%}
            {%- render 'reel-video-schema', reel: reel -%}
            {%- capture card -%}
              <button type="button" class="reelup-trigger__button reelup-strip__poster" aria-label="{{ 'reels.play_named_label' | t: title: reel.title.value | escape }}">
                {%- if reel.config.value.posterUrl != blank -%}
                  <img class="reelup-trigger__poster" src="{{ reel.config.value.posterUrl | escape }}" alt="" loading="lazy" width="360" height="640">
                {%- endif -%}
                <span class="reelup-strip__play" aria-hidden="true"></span>
                {%- if show_duration -%}{%- render 'reel-duration', reel: reel, icon: true -%}{%- endif -%}
              </button>
            {%- endcapture -%}
            <li class="reelup-strip__item">
              {%- render 'reel-trigger', reel: reel, style: widget_style, inner: card, muted_default: true, autoplay_default: true -%}
              {%- if show_caption -%}
                <p class="reelup-strip__caption">{{ reel.title.value | escape }}</p>
              {%- endif -%}
              {%- if show_product -%}
                {%- assign lead = reel.tagged_products.value.first -%}
                {%- if lead -%}
                  <a class="reelup-strip__product" href="{{ lead.url }}">
                    {%- if lead.featured_image -%}
                      <img src="{{ lead.featured_image | image_url: width: 72 }}" alt="" loading="lazy" width="28" height="28">
                    {%- endif -%}
                    <span class="reelup-strip__product-text">
                      <span class="reelup-strip__product-title">{{ lead.title | escape }}</span>
                      {%- if show_price -%}<span class="reelup-strip__product-price">{{ lead.price | money }}</span>{%- endif -%}
                    </span>
                  </a>
                {%- endif -%}
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if layout == 'carousel' and visible_count > 1 -%}
        <button type="button" class="reelup-arrow reelup-arrow--prev" data-reelup-strip-prev aria-label="{{ 'reels.scroll_back_label' | t }}" hidden>
          <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.7 4.3a1 1 0 0 1 0 1.4L8.42 10l4.3 4.3a1 1 0 0 1-1.42 1.4l-5-5a1 1 0 0 1 0-1.4l5-5a1 1 0 0 1 1.42 0Z"/></svg>
        </button>
        <button type="button" class="reelup-arrow reelup-arrow--next" data-reelup-strip-next aria-label="{{ 'reels.scroll_forward_label' | t }}" hidden>
          <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M7.3 15.7a1 1 0 0 1 0-1.4l4.28-4.3-4.3-4.3a1 1 0 1 1 1.42-1.4l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 0 1-1.42 0Z"/></svg>
        </button>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product page reels",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    {
      "type": "paragraph",
      "content": "Videos, layout and colors are set in the app under Widgets › Product page reels. Needs the Shoppable Videos app embed turned on."
    }
  ]
}
{% endschema %}
