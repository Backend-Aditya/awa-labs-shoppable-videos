{% doc %}
PRODUCT_PAGE_REELS: a filmstrip of short clips under the product details,
9:16 posters with a length chip, the reel title, and the first tagged
product beneath each so shoppers see what's inside before they tap.
Opening a clip plays it in the shared viewer, with next/previous through
the rest of the strip. Settings live in the app's widget editor and reach
this block through the shop-level widget metafield.

Self-sufficient: the schema loads reel-widgets.css and reel-loader.js, which
pulls in the viewer runtime when the app embed is off.

@example
{% content_for 'block', type: 'product-page-reels', id: 'reels' %}
{% enddoc %}

{% comment %}
  Literal namespace, not {% render 'reel-namespace' %}: the theme editor wraps
  rendered snippet output in BEGIN/END comments, which corrupts a captured
  string. Keep in sync with reel-namespace.liquid (checked by
  scripts/check-reel-namespace.mjs).
{% endcomment %}
{% assign reel_namespace = 'app--404281098241' %}

{%- liquid
  # The widget this block shows: the one picked in its Widget setting, or
  # (none picked, or the pick was deleted) the kind's latest live widget.
  assign picked = block.settings.widget
  if picked != blank and picked.config.value
    assign widget = picked.config.value
    assign reels = picked.reels.value
  else
    assign widget = shop.metafields[reel_namespace].product_page_reels_widget.value
    assign reels = shop.metafields[reel_namespace].product_page_reels_widget_reels.value
  endif
  assign widget_style = widget.style
  assign target_product = product

  assign show_widget = false
  if widget.published
    case widget.targetRule.type
      when 'all_products'
        assign show_widget = true
      when 'handles'
        if target_product and widget.targetRule.handles contains target_product.handle
          assign show_widget = true
        endif
      when 'collections'
        if collection and widget.targetRule.handles contains collection.handle
          assign show_widget = true
        elsif target_product
          for product_collection in target_product.collections
            if widget.targetRule.handles contains product_collection.handle
              assign show_widget = true
              break
            endif
          endfor
        endif
    endcase
  endif
  if widget.pageTypes.size > 0
    unless widget.pageTypes contains template.name
      assign show_widget = false
    endunless
  endif

  assign visible_count = 0
  if show_widget
    for reel in reels
      if reel.published.value and reel.config.value.hlsManifestUrl != blank
        assign visible_count = visible_count | plus: 1
      endif
    endfor
  endif

  assign layout = widget_style.layoutMode | default: 'carousel'
  if layout != 'grid'
    assign layout = 'carousel'
  endif

  assign show_caption = true
  if widget_style.showCaption == false
    assign show_caption = false
  endif
  assign show_duration = true
  if widget_style.showDuration == false
    assign show_duration = false
  endif
  assign show_product = true
  if widget_style.showProductPreview == false
    assign show_product = false
  endif
  assign show_price = true
  if widget_style.showPrice == false
    assign show_price = false
  endif

  # Card templates, shared with the stacked carousel: "title" is this
  # widget's original look (caption + featured product under the video).
  assign card_template = widget_style.cardTemplate | default: 'title'
  assign card_below = false
  case card_template
    when 'classic', 'modern', 'vibrant'
      assign card_below = true
    when 'overlay'
    else
      assign card_template = 'title'
  endcase
  assign show_play = true
  if widget_style.showPlayIcon == false
    assign show_play = false
  endif
  assign show_card_badge = false
  if widget_style.showCardBadge == true
    assign show_card_badge = true
  endif

  case widget_style.cornerStyle
    when 'sharp'
      assign radius = '0px'
    when 'soft'
      assign radius = '18px'
    else
      assign radius = '10px'
  endcase

  assign card_width = widget_style.triggerSize | default: 200 | times: 1
-%}

{%- if visible_count > 0 -%}
  {%- render 'reel-config' -%}
  {%- capture wrapper_style -%}
    --awa-sv-radius: {{ radius }};
    --awa-sv-card-width: {{ card_width }}px;
    --awa-sv-columns: {{ widget_style.columns | default: 4 | times: 1 }};
    {%- if widget_style.accentColor != blank %}--awa-sv-accent: {{ widget_style.accentColor | escape }}; --awa-sv-play: {{ widget_style.accentColor | escape }};{% endif -%}
    {%- if widget_style.backgroundColor != blank %}--awa-sv-bg: {{ widget_style.backgroundColor | escape }};{% endif -%}
    {%- if widget_style.textColor != blank %}--awa-sv-text: {{ widget_style.textColor | escape }};{% endif -%}
    {%- if widget_style.accentColor != blank %}--awa-sv-eyebrow: {{ widget_style.accentColor | escape }};{% endif -%}
    {%- comment -%} Sizing and spacing (desktop, then phones): only what the merchant set. {%- endcomment -%}
    {%- if widget_style.eyebrowSize %}--awa-sv-eyebrow-size: {{ widget_style.eyebrowSize | times: 1 }}px;{% endif -%}
    {%- if widget_style.headingSize %}--awa-sv-heading-size: {{ widget_style.headingSize | times: 1 }}px;{% endif -%}
    {%- if widget_style.subheadingSize %}--awa-sv-sub-size: {{ widget_style.subheadingSize | times: 1 }}px;{% endif -%}
    {%- if widget_style.cardTextSize %}--awa-sv-card-text: {{ widget_style.cardTextSize | times: 1 }}px;{% endif -%}
    {%- if widget_style.cardGap != nil %}--awa-sv-gap: {{ widget_style.cardGap | times: 1 }}px;{% endif -%}
    {%- if widget_style.sectionPaddingY != nil %}--awa-sv-pad-y: {{ widget_style.sectionPaddingY | times: 1 }}px;{% endif -%}
    {%- if widget_style.sectionPaddingX != nil %}--awa-sv-pad-x: {{ widget_style.sectionPaddingX | times: 1 }}px;{% endif -%}
    {%- if widget_style.triggerSizeMobile %}--awa-sv-card-w-m: {{ widget_style.triggerSizeMobile | times: 1 }}px;{% endif -%}
    {%- if widget_style.columnsMobile %}--awa-sv-columns-m: {{ widget_style.columnsMobile | times: 1 }}; --awa-sv-grid-columns-m: {{ widget_style.columnsMobile | floor }};{% endif -%}
    {%- if widget_style.eyebrowSizeMobile %}--awa-sv-eyebrow-size-m: {{ widget_style.eyebrowSizeMobile | times: 1 }}px;{% endif -%}
    {%- if widget_style.headingSizeMobile %}--awa-sv-heading-size-m: {{ widget_style.headingSizeMobile | times: 1 }}px;{% endif -%}
    {%- if widget_style.subheadingSizeMobile %}--awa-sv-sub-size-m: {{ widget_style.subheadingSizeMobile | times: 1 }}px;{% endif -%}
    {%- if widget_style.cardTextSizeMobile %}--awa-sv-card-text-m: {{ widget_style.cardTextSizeMobile | times: 1 }}px;{% endif -%}
    {%- if widget_style.cardGapMobile != nil %}--awa-sv-gap-m: {{ widget_style.cardGapMobile | times: 1 }}px;{% endif -%}
    {%- if widget_style.sectionPaddingYMobile != nil %}--awa-sv-pad-y-m: {{ widget_style.sectionPaddingYMobile | times: 1 }}px;{% endif -%}
    {%- if widget_style.sectionPaddingXMobile != nil %}--awa-sv-pad-x-m: {{ widget_style.sectionPaddingXMobile | times: 1 }}px;{% endif -%}
    {%- if widget_style.badgeColor != blank %}--awa-sv-card-badge: {{ widget_style.badgeColor | escape }};{% endif -%}
    {%- if widget_style.ctaColor != blank %}--awa-sv-cta: {{ widget_style.ctaColor | escape }};{% endif -%}
    {%- if widget_style.ctaTextColor != blank %}--awa-sv-cta-text: {{ widget_style.ctaTextColor | escape }};{% endif -%}
  {%- endcapture -%}
  <section
    class="awa-sv awa-sv-showcase awa-sv-strip awa-sv-strip--{{ layout }} awa-sv-cards--{{ card_template }} awa-sv-shadow--{{ widget_style.shadowPreset | default: 'none' | escape }} awa-sv-device--{{ widget.deviceVisibility | default: 'all' | escape }}{% if widget_style.backgroundColor != blank %} awa-sv--filled{% endif %}"
    style="{{ wrapper_style | strip_newlines }}"
    {%- assign strip_label = block.settings.heading | default: widget_style.heading -%}
    {% if strip_label != blank %}aria-label="{{ strip_label | escape }}"{% endif %}
    {{ block.shopify_attributes }}
  >
    {%- render 'reel-section-header', style: widget_style, settings: block.settings, align: 'start' -%}
    <div class="awa-sv-strip__viewport">
      <ul class="awa-sv-strip__track" data-awa-sv-group data-awa-sv-strip role="list">
        {%- assign rendered = 0 -%}
        {%- for reel in reels -%}
          {%- if reel.published.value and reel.config.value.hlsManifestUrl != blank -%}
            {%- assign rendered = rendered | plus: 1 -%}
            {%- liquid
              assign play_label = 'reels.play_label' | t
              if reel.title.value != blank
                assign play_label = 'reels.play_named_label' | t: title: reel.title.value
              endif
              assign first = false
              if rendered == 1
                assign first = true
              endif
            -%}
            {%- render 'reel-video-schema', reel: reel -%}
            {%- liquid
              assign lead = reel.tagged_products.value | first
              assign lead_variant = lead.selected_or_first_available_variant
              assign card_discount = 0
              if show_card_badge and lead_variant.compare_at_price > lead_variant.price
                assign half = lead_variant.compare_at_price | divided_by: 2
                assign card_discount = lead_variant.compare_at_price | minus: lead_variant.price | times: 100 | plus: half | divided_by: lead_variant.compare_at_price
              endif
              assign has_lead = false
              if lead or reel.title.value != blank
                assign has_lead = true
              endif
            -%}
            {%- capture card -%}
              <button type="button" class="awa-sv-trigger__button awa-sv-strip__poster" aria-label="{{ play_label }}">
                {%- if reel.config.value.posterUrl != blank -%}
                  {%- capture poster_sizes %}min({{ card_width }}px, 70vw){% endcapture -%}
                  {%- render 'reel-poster', url: reel.config.value.posterUrl, height: 800, width_attr: 360, height_attr: 640, srcset_heights: '480,800,1200', sizes: poster_sizes, eager: first, priority: first -%}
                {%- endif -%}
                {%- if card_discount > 0 -%}
                  <span class="awa-sv-card__badge">{{ 'reels.percent_off' | t: percent: card_discount }}</span>
                {%- endif -%}
                {%- if show_play -%}
                  <span class="awa-sv-strip__play awa-sv-play" aria-hidden="true">{%- render 'reel-icon', name: 'play', size: 18 -%}</span>
                {%- endif -%}
                {%- if card_template == 'overlay' and has_lead -%}
                  <span class="awa-sv-card__overlay">{%- render 'reel-card-lead', reel: reel, template: card_template, show_price: show_price -%}</span>
                {%- endif -%}
                {%- if show_duration -%}{%- render 'reel-duration', reel: reel, icon: true -%}{%- endif -%}
              </button>
              {%- if card_below -%}
                {%- comment -%} Under the video; a click opens the same reel (reel-trigger.js, data-awa-sv-open). {%- endcomment -%}
                <div class="awa-sv-card__info" data-awa-sv-open>
                  {%- render 'reel-card-lead', reel: reel, template: card_template, show_price: show_price -%}
                  {%- if card_template != 'classic' -%}
                    <span class="awa-sv-card__shop" aria-hidden="true">{{ 'reels.shop_now' | t }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endcapture -%}
            <li class="awa-sv-strip__item">
              {%- render 'reel-trigger', reel: reel, style: widget_style, source: 'product_page_reels', inner: card, muted_default: true, autoplay_default: true, details_default: true, image_size_default: 'large', corners_default: 'square' -%}
              {%- if card_template == 'title' and show_caption and reel.title.value != blank -%}
                <p class="awa-sv-strip__caption">{{ reel.title.value | escape }}</p>
              {%- endif -%}
              {%- if card_template == 'title' and show_product -%}
                {%- if lead -%}
                  <a class="awa-sv-strip__product" href="{{ lead.url }}">
                    {%- if lead.featured_image -%}
                      <img src="{{ lead.featured_image | image_url: width: 72 }}" alt="" loading="lazy" width="28" height="28">
                    {%- endif -%}
                    <span class="awa-sv-strip__product-text">
                      <span class="awa-sv-strip__product-title">{{ lead.title | escape }}</span>
                      {%- if show_price -%}<span class="awa-sv-strip__product-price">{{ lead.price | money }}</span>{%- endif -%}
                    </span>
                  </a>
                {%- endif -%}
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if layout == 'carousel' and visible_count > 1 -%}
        <button type="button" class="awa-sv-arrow awa-sv-arrow--prev" data-awa-sv-strip-prev aria-label="{{ 'reels.scroll_back_label' | t }}" hidden>
          {%- render 'reel-icon', name: 'chevron-left', size: 16 -%}
        </button>
        <button type="button" class="awa-sv-arrow awa-sv-arrow--next" data-awa-sv-strip-next aria-label="{{ 'reels.scroll_forward_label' | t }}" hidden>
          {%- render 'reel-icon', name: 'chevron-right', size: 16 -%}
        </button>
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="awa-sv awa-sv-placeholder" {{ block.shopify_attributes }}>{{ 'reels.editor_placeholder' | t }}</div>
{%- endif -%}

{% schema %}
{
  "name": "Product page reels",
  "target": "section",
  "javascript": "reel-loader.js",
  "stylesheet": "reel-widgets.css",
  "settings": [
    {
      "type": "metaobject",
      "id": "widget",
      "label": "Widget",
      "metaobject_type": "app--404281098241--product_page_reels_widget",
      "info": "Which of your product page reels widgets to show. Leave empty to show your most recently saved live one."
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "paragraph",
      "content": "Edit the header here with a live preview. Leave a field empty to use the text set in the app."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "header_align",
      "label": "Alignment",
      "options": [
        { "value": "default", "label": "As set in the app" },
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "link_label", "label": "Link label", "info": "e.g. View all. Shown under the header with the link below." },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "paragraph",
      "content": "Videos, card design, colors, sizes and the popup are set in the app under Widgets › Product page reels."
    }
  ]
}
{% endschema %}
