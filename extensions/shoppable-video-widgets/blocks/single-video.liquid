{% doc %}
SINGLE_VIDEO ("Featured video"): one hero reel with its tagged products
listed beside it — variant picker and add to cart right on the page, no
need to open the video first. "Video only" drops the product column for a
centred poster. The poster opens the shared viewer.

@example
{% content_for 'block', type: 'single-video', id: 'single-video' %}
{% enddoc %}

{{ 'reel-widgets.css' | asset_url | stylesheet_tag }}

{% assign reel_namespace = 'app--404281098241' %}

{%- liquid
  assign widget = shop.metafields[reel_namespace].single_video_widget.value
  assign widget_style = widget.style
  assign reel = shop.metafields[reel_namespace].single_video_featured_reel.value

  assign show_widget = false
  if widget.published
    case widget.targetRule.type
      when 'all_products'
        assign show_widget = true
      when 'handles'
        if product and widget.targetRule.handles contains product.handle
          assign show_widget = true
        endif
      when 'collections'
        for collection in product.collections
          if widget.targetRule.handles contains collection.handle
            assign show_widget = true
            break
          endif
        endfor
    endcase
  endif
  if widget.pageTypes.size > 0
    unless widget.pageTypes contains template.name
      assign show_widget = false
    endunless
  endif
  unless reel and reel.published.value and reel.config.value.hlsManifestUrl != blank
    assign show_widget = false
  endunless

  assign layout = widget_style.singleLayout | default: 'split'
  if reel.tagged_products.value.size == 0
    assign layout = 'poster'
  endif

  assign show_duration = true
  if widget_style.showDuration == false
    assign show_duration = false
  endif

  case widget_style.cornerStyle
    when 'sharp'
      assign radius = '0px'
    when 'soft'
      assign radius = '18px'
    else
      assign radius = '10px'
  endcase
-%}

{%- if show_widget -%}
  {%- render 'reel-video-schema', reel: reel -%}
  {%- capture wrapper_style -%}
    --ru-radius: {{ radius }};
    --ru-video-width: {{ widget_style.triggerSize | default: 340 }}px;
    {%- if widget_style.accentColor != blank %}--ru-accent: {{ widget_style.accentColor }};{% endif -%}
    {%- if widget_style.backgroundColor != blank %}--ru-bg: {{ widget_style.backgroundColor }};{% endif -%}
    {%- if widget_style.textColor != blank %}--ru-text: {{ widget_style.textColor }};{% endif -%}
    {%- if widget_style.ctaColor != blank %}--ru-cta: {{ widget_style.ctaColor }};{% endif -%}
    {%- if widget_style.ctaTextColor != blank %}--ru-cta-text: {{ widget_style.ctaTextColor }};{% endif -%}
  {%- endcapture -%}
  {%- capture poster -%}
    <button type="button" class="reelup-trigger__button reelup-feature__poster" aria-label="{{ 'reels.play_named_label' | t: title: reel.title.value | escape }}">
      {%- if reel.config.value.posterUrl != blank -%}
        <img class="reelup-trigger__poster" src="{{ reel.config.value.posterUrl | escape }}" alt="" loading="lazy" width="540" height="960">
      {%- endif -%}
      <span class="reelup-feature__play" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 10 10" focusable="false"><path fill="currentColor" d="M2 1.2v7.6a.5.5 0 0 0 .76.43l6.1-3.8a.5.5 0 0 0 0-.86L2.76.77A.5.5 0 0 0 2 1.2Z"/></svg>
      </span>
      {%- if show_duration -%}{%- render 'reel-duration', reel: reel -%}{%- endif -%}
    </button>
  {%- endcapture -%}
  <section
    class="reelup reelup-feature reelup-feature--{{ layout }} reelup-shadow--{{ widget_style.shadowPreset | default: 'soft' }} reelup-device--{{ widget.deviceVisibility | default: 'all' }}{% if widget_style.backgroundColor != blank %} reelup--filled{% endif %} reelup-cta--{{ widget_style.ctaStyle | default: 'pill' }}"
    style="{{ wrapper_style | strip_newlines }}"
    aria-label="{{ widget_style.heading | default: reel.title.value | escape }}"
    {{ block.shopify_attributes }}
  >
    {%- if layout == 'poster' and widget_style.heading != blank -%}
      <h2 class="reelup-heading reelup-heading--center">{{ widget_style.heading | escape }}</h2>
    {%- endif -%}
    <div class="reelup-feature__video">
      {%- render 'reel-trigger', reel: reel, style: widget_style, inner: poster, muted_default: false, autoplay_default: true -%}
    </div>
    {%- if layout == 'split' -%}
      <div class="reelup-feature__body" data-reelup-reel-id="{{ reel.system.id }}">
        {%- if widget_style.heading != blank -%}
          <h2 class="reelup-feature__heading">{{ widget_style.heading | escape }}</h2>
        {%- endif -%}
        <p class="reelup-feature__subtitle">{{ reel.title.value | escape }}</p>
        <div class="reelup-feature__products">
          {%- render 'reel-product-card' for reel.tagged_products.value as product, style: widget_style -%}
        </div>
        <p class="reelup-feature__status" data-reelup-cart-status hidden>
          <span class="reelup-cart-message" aria-live="polite"></span>
          <a href="{{ routes.cart_url }}">{{ 'reels.view_cart' | t }}</a>
        </p>
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Featured video",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    {
      "type": "paragraph",
      "content": "The video, layout and colors are set in the app under Widgets › Featured video. Needs the Shoppable Videos app embed turned on."
    }
  ]
}
{% endschema %}
