{% doc %}
ADD_TO_CART_VIDEO: a compact, full-width row meant to sit right under the
buy buttons, thumbnail with a play mark, a short label, the reel's title
and length, and a chevron. Quiet enough to live inside the product form,
clear enough that it reads as "watch this before you buy".

Self-sufficient: the schema loads reel-widgets.css and reel-loader.js, which
pulls in the viewer runtime when the app embed is off.

@example
{% content_for 'block', type: 'add-to-cart-video', id: 'add-to-cart-video' %}
{% enddoc %}

{% assign reel_namespace = 'app--404281098241' %}

{%- liquid
  # The widget this block shows: the one picked in its Widget setting, or
  # (none picked, or the pick was deleted) the kind's latest live widget.
  assign picked = block.settings.widget
  if picked != blank and picked.config.value
    assign widget = picked.config.value
    assign reel = picked.featured_reel.value
  else
    assign widget = shop.metafields[reel_namespace].add_to_cart_video_widget.value
    assign reel = shop.metafields[reel_namespace].add_to_cart_video_featured_reel.value
  endif
  assign widget_style = widget.style
  assign target_product = product

  assign show_widget = false
  if widget.published
    case widget.targetRule.type
      when 'all_products'
        assign show_widget = true
      when 'handles'
        if target_product and widget.targetRule.handles contains target_product.handle
          assign show_widget = true
        endif
      when 'collections'
        if collection and widget.targetRule.handles contains collection.handle
          assign show_widget = true
        elsif target_product
          for product_collection in target_product.collections
            if widget.targetRule.handles contains product_collection.handle
              assign show_widget = true
              break
            endif
          endfor
        endif
    endcase
  endif
  if widget.pageTypes.size > 0
    unless widget.pageTypes contains template.name
      assign show_widget = false
    endunless
  endif
  unless reel and reel.published.value and reel.config.value.hlsManifestUrl != blank
    assign show_widget = false
  endunless

  assign label = widget_style.watchLabel | escape
  if label == blank
    assign label = 'reels.watch_label' | t
  endif

  assign show_duration = true
  if widget_style.showDuration == false
    assign show_duration = false
  endif

  case widget_style.cornerStyle
    when 'sharp'
      assign radius = '0px'
    when 'soft'
      assign radius = '18px'
    else
      assign radius = '10px'
  endcase
-%}

{%- if show_widget -%}
  {%- render 'reel-config' -%}
  {%- render 'reel-video-schema', reel: reel -%}
  {%- capture wrapper_style -%}
    --awa-sv-radius: {{ radius }};
    --awa-sv-thumb: {{ widget_style.triggerSize | default: 56 | times: 1 }}px;
    {%- if widget_style.accentColor != blank %}--awa-sv-accent: {{ widget_style.accentColor | escape }}; --awa-sv-play: {{ widget_style.accentColor | escape }};{% endif -%}
    {%- if widget_style.backgroundColor != blank %}--awa-sv-bg: {{ widget_style.backgroundColor | escape }};{% endif -%}
    {%- if widget_style.textColor != blank %}--awa-sv-text: {{ widget_style.textColor | escape }};{% endif -%}
  {%- endcapture -%}
  {%- capture row -%}
    <button type="button" class="awa-sv-trigger__button awa-sv-atc__button">
      <span class="awa-sv-atc__thumb">
        {%- if reel.config.value.posterUrl != blank -%}
          {%- render 'reel-poster', url: reel.config.value.posterUrl, height: 200, width_attr: 192, height_attr: 192 -%}
        {%- endif -%}
        <span class="awa-sv-atc__play awa-sv-play" aria-hidden="true">
          {%- render 'reel-icon', name: 'play', size: 9 -%}
        </span>
      </span>
      <span class="awa-sv-atc__text">
        <span class="awa-sv-atc__label">{{ label }}</span>
        <span class="awa-sv-atc__meta">
          {%- if reel.title.value != blank -%}<span>{{ reel.title.value | escape }}</span>{%- endif -%}
          {%- if show_duration and reel.config.value.durationSeconds > 0 -%}
            {%- assign total = reel.config.value.durationSeconds | round -%}
            {%- assign seconds = total | modulo: 60 -%}
            <span class="awa-sv-atc__length"><span class="awa-sv-visually-hidden">{{ 'reels.duration_label' | t }} </span>{{ total | divided_by: 60 }}:{% if seconds < 10 %}0{% endif %}{{ seconds }}</span>
          {%- endif -%}
        </span>
      </span>
      {%- render 'reel-icon', name: 'chevron-right', size: 16, class: 'awa-sv-atc__chevron' -%}
    </button>
  {%- endcapture -%}
  <div
    class="awa-sv awa-sv-atc awa-sv-device--{{ widget.deviceVisibility | default: 'all' | escape }}{% if widget_style.backgroundColor != blank %} awa-sv--filled{% endif %}"
    style="{{ wrapper_style | strip_newlines }}"
    {{ block.shopify_attributes }}
  >
    {%- render 'reel-trigger', reel: reel, style: widget_style, source: 'add_to_cart_video', inner: row, muted_default: false, details_default: true, image_size_default: 'large', corners_default: 'square' -%}
  </div>
{%- elsif request.design_mode -%}
  <div class="awa-sv awa-sv-placeholder" {{ block.shopify_attributes }}>{{ 'reels.editor_placeholder' | t }}</div>
{%- endif -%}

{% schema %}
{
  "name": "Add-to-cart video",
  "target": "section",
  "javascript": "reel-loader.js",
  "stylesheet": "reel-widgets.css",
  "settings": [
    {
      "type": "metaobject",
      "id": "widget",
      "label": "Widget",
      "metaobject_type": "app--404281098241--add_to_cart_video_widget",
      "info": "Which of your add-to-cart video widgets to show. Leave empty to show your most recently saved live one."
    },
    {
      "type": "paragraph",
      "content": "Place this right below Buy buttons. The video, label and colors are set in the app under Widgets › Add-to-cart video."
    }
  ]
}
{% endschema %}
