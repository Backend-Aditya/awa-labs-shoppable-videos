{% doc %}
ADD_TO_CART_VIDEO: a compact, full-width row meant to sit right under the
buy buttons — thumbnail with a play mark, a short label, the reel's title
and length, and a chevron. Quiet enough to live inside the product form,
clear enough that it reads as "watch this before you buy".

@example
{% content_for 'block', type: 'add-to-cart-video', id: 'add-to-cart-video' %}
{% enddoc %}

{{ 'reel-widgets.css' | asset_url | stylesheet_tag }}

{% assign reel_namespace = 'app--404281098241' %}

{%- liquid
  assign widget = shop.metafields[reel_namespace].add_to_cart_video_widget.value
  assign widget_style = widget.style
  assign reel = shop.metafields[reel_namespace].add_to_cart_video_featured_reel.value

  assign show_widget = false
  if widget.published
    case widget.targetRule.type
      when 'all_products'
        assign show_widget = true
      when 'handles'
        if product and widget.targetRule.handles contains product.handle
          assign show_widget = true
        endif
      when 'collections'
        for collection in product.collections
          if widget.targetRule.handles contains collection.handle
            assign show_widget = true
            break
          endif
        endfor
    endcase
  endif
  if widget.pageTypes.size > 0
    unless widget.pageTypes contains template.name
      assign show_widget = false
    endunless
  endif
  unless reel and reel.published.value and reel.config.value.hlsManifestUrl != blank
    assign show_widget = false
  endunless

  assign label = widget_style.watchLabel
  if label == blank
    assign label = 'reels.watch_label' | t
  endif

  assign show_duration = true
  if widget_style.showDuration == false
    assign show_duration = false
  endif

  case widget_style.cornerStyle
    when 'sharp'
      assign radius = '0px'
    when 'soft'
      assign radius = '18px'
    else
      assign radius = '10px'
  endcase
-%}

{%- if show_widget -%}
  {%- render 'reel-video-schema', reel: reel -%}
  {%- capture wrapper_style -%}
    --ru-radius: {{ radius }};
    --ru-thumb: {{ widget_style.triggerSize | default: 56 }}px;
    {%- if widget_style.accentColor != blank %}--ru-accent: {{ widget_style.accentColor }};{% endif -%}
    {%- if widget_style.backgroundColor != blank %}--ru-bg: {{ widget_style.backgroundColor }};{% endif -%}
    {%- if widget_style.textColor != blank %}--ru-text: {{ widget_style.textColor }};{% endif -%}
  {%- endcapture -%}
  {%- capture row -%}
    <button type="button" class="reelup-trigger__button reelup-atc__button">
      <span class="reelup-atc__thumb">
        {%- if reel.config.value.posterUrl != blank -%}
          <img class="reelup-trigger__poster" src="{{ reel.config.value.posterUrl | escape }}" alt="" loading="lazy" width="192" height="192">
        {%- endif -%}
        <span class="reelup-atc__play" aria-hidden="true">
          <svg width="9" height="9" viewBox="0 0 10 10" focusable="false"><path fill="currentColor" d="M2 1.2v7.6a.5.5 0 0 0 .76.43l6.1-3.8a.5.5 0 0 0 0-.86L2.76.77A.5.5 0 0 0 2 1.2Z"/></svg>
        </span>
      </span>
      <span class="reelup-atc__text">
        <span class="reelup-atc__label">{{ label | escape }}</span>
        <span class="reelup-atc__meta">
          {{- reel.title.value | escape -}}
          {%- if show_duration and reel.config.value.durationSeconds > 0 -%}
            {%- assign total = reel.config.value.durationSeconds | round -%}
            {%- assign seconds = total | modulo: 60 -%}
            <span class="reelup-atc__length">{{ total | divided_by: 60 }}:{% if seconds < 10 %}0{% endif %}{{ seconds }}</span>
          {%- endif -%}
        </span>
      </span>
      <svg class="reelup-atc__chevron" width="16" height="16" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M7.3 15.7a1 1 0 0 1 0-1.4l4.28-4.3-4.3-4.3a1 1 0 1 1 1.42-1.4l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 0 1-1.42 0Z"/></svg>
    </button>
  {%- endcapture -%}
  <div
    class="reelup reelup-atc reelup-device--{{ widget.deviceVisibility | default: 'all' }}{% if widget_style.backgroundColor != blank %} reelup--filled{% endif %}"
    style="{{ wrapper_style | strip_newlines }}"
    {{ block.shopify_attributes }}
  >
    {%- render 'reel-trigger', reel: reel, style: widget_style, inner: row, muted_default: false -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Add-to-cart video",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    {
      "type": "paragraph",
      "content": "Place this right below Buy buttons. The video, label and colors are set in the app under Widgets › Add-to-cart video. Needs the Shoppable Videos app embed turned on."
    }
  ]
}
{% endschema %}
