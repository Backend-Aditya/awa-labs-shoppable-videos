{% doc %}
The app's one master switch: an app embed (target "body") the merchant turns
on once under Theme settings › App embeds. Shopify's own embed toggle is the
on/off mechanism — no custom flag.

Three jobs:
1. Loads the storefront scripts and viewer styles once per page. Without
   this embed no viewer JS exists, so every other block renders its markup
   but does nothing when tapped.
2. Publishes shared viewer labels and locale-aware cart routes as JSON
   (#reelup-config) so blocks don't repeat them on every trigger.
3. Renders the REEL_POPS widget ("Floating video"): a small player pinned
   to a corner of every page it targets.

@example
Enabled under Theme settings › App embeds — not placed with {% content_for %}.
{% enddoc %}

<script src="{{ 'reel-hls.js' | asset_url }}" defer></script>
<script src="{{ 'reel-lightbox.js' | asset_url }}" defer></script>
<script src="{{ 'reel-story.js' | asset_url }}" defer></script>
<script src="{{ 'reel-trigger.js' | asset_url }}" defer></script>
<script src="{{ 'reel-pop.js' | asset_url }}" defer></script>

{{ 'reel-lightbox.css' | asset_url | stylesheet_tag }}
{{ 'reel-widgets.css' | asset_url | stylesheet_tag }}

{% assign reel_namespace = 'app--404281098241' %}
{%- assign brand = shop.metafields[reel_namespace].brand.value -%}
{%- if brand -%}
  <style>
    :root {
      {%- if brand.accentColor != blank %}--ru-brand-accent: {{ brand.accentColor }};{% endif -%}
      {%- if brand.buttonColor != blank %}--ru-brand-cta: {{ brand.buttonColor }};{% endif -%}
      {%- if brand.buttonTextColor != blank %}--ru-brand-cta-text: {{ brand.buttonTextColor }};{% endif -%}
      {%- if brand.salePriceColor != blank %}--ru-brand-sale: {{ brand.salePriceColor }};{% endif -%}
    }
    {%- if brand.fontFamily == 'system' %}
    .reelup, .reelup-viewer, .reelup-story { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    {%- endif %}
  </style>
{%- endif -%}

<script type="application/json" id="reelup-config">
  {
    "cartUrl": {{ routes.cart_url | json }},
    "cartAddUrl": {{ routes.cart_add_url | append: '.js' | json }},
    "cartJsUrl": {{ routes.cart_url | append: '.js' | json }},
    "recommendationsUrl": {{ routes.product_recommendations_url | append: '.json' | json }},
    "currency": {{ cart.currency.iso_code | json }},
    "locale": {{ request.locale.iso_code | json }},
    "viewerTheme": {{ brand.viewerTheme | default: 'dark' | json }},
    "labels": {
      "close": {{ 'reels.close_label' | t | json }},
      "play": {{ 'reels.play_label' | t | json }},
      "pause": {{ 'reels.pause_label' | t | json }},
      "mute": {{ 'reels.mute_label' | t | json }},
      "unmute": {{ 'reels.unmute_label' | t | json }},
      "shop": {{ 'reels.shop_this_video_label' | t | json }},
      "previous": {{ 'reels.previous_label' | t | json }},
      "next": {{ 'reels.next_label' | t | json }},
      "viewCart": {{ 'reels.view_cart' | t | json }},
      "addedToCart": {{ 'reels.added_to_cart_status' | t | json }},
      "addFailed": {{ 'reels.add_failed' | t | json }},
      "closeProducts": {{ 'reels.close_products_label' | t | json }},
      "share": {{ 'reels.share_label' | t | json }},
      "linkCopied": {{ 'reels.link_copied' | t | json }},
      "youMayLike": {{ 'reels.you_may_like' | t | json }},
      "of": {{ 'reels.position_label' | t: current: '__CURRENT__', total: '__TOTAL__' | json }}
    }
  }
</script>

{%- liquid
  assign widget = shop.metafields[reel_namespace].reel_pops_widget.value
  assign widget_style = widget.style
  assign reel = shop.metafields[reel_namespace].reel_pops_featured_reel.value

  assign show_widget = false
  if widget.published
    case widget.targetRule.type
      when 'all_products'
        assign show_widget = true
      when 'handles'
        if product and widget.targetRule.handles contains product.handle
          assign show_widget = true
        endif
      when 'collections'
        for collection in product.collections
          if widget.targetRule.handles contains collection.handle
            assign show_widget = true
            break
          endif
        endfor
    endcase
  endif
  if widget.pageTypes.size > 0
    unless widget.pageTypes contains template.name
      assign show_widget = false
    endunless
  endif
  unless reel and reel.published.value and reel.config.value.hlsManifestUrl != blank
    assign show_widget = false
  endunless

  assign position = widget_style.position | default: 'bottom_right' | replace: '_', '-'
  assign shape = widget_style.popShape | default: 'portrait'
  assign pulse = true
  if widget_style.showPulse == false
    assign pulse = false
  endif
  assign preview = false
  if shape == 'portrait'
    assign preview = true
  endif
-%}

{%- if show_widget -%}
  {%- render 'reel-video-schema', reel: reel -%}
  {%- capture player -%}
    <button type="button" class="reelup-trigger__button reelup-pop__player" aria-label="{{ 'reels.play_named_label' | t: title: reel.title.value | escape }}">
      {%- if reel.config.value.posterUrl != blank -%}
        <img class="reelup-trigger__poster" src="{{ reel.config.value.posterUrl | escape }}" alt="" loading="lazy" width="240" height="426">
      {%- endif -%}
      {%- if shape == 'circle' -%}
        <span class="reelup-pop__play" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 10 10" focusable="false"><path fill="currentColor" d="M2 1.2v7.6a.5.5 0 0 0 .76.43l6.1-3.8a.5.5 0 0 0 0-.86L2.76.77A.5.5 0 0 0 2 1.2Z"/></svg>
        </span>
      {%- endif -%}
    </button>
  {%- endcapture -%}
  <div
    class="reelup reelup-pop reelup-pop--{{ position }} reelup-pop--{{ shape }}{% if pulse %} reelup-pop--pulse{% endif %} reelup-device--{{ widget.deviceVisibility | default: 'all' }}"
    data-reelup-pop
    data-reel-id="{{ reel.system.id }}"
    data-block-id="{{ block.id }}"
    data-delay="{{ widget_style.popDelay | default: 0 }}"
    style="--ru-pop-size: {{ widget_style.triggerSize | default: 96 }}px; --ru-pop-border: {{ widget_style.accentColor | default: '#ffffff' }};"
    hidden
  >
    <div class="reelup-pop__frame">
      {%- render 'reel-trigger', reel: reel, style: widget_style, inner: player, muted_default: false, autoplay_preview: preview -%}
      <button type="button" class="reelup-pop__dismiss" data-reelup-pop-dismiss aria-label="{{ 'reels.dismiss_label' | t }}">
        <svg width="10" height="10" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M4.3 4.3a1 1 0 0 1 1.4 0L10 8.6l4.3-4.3a1 1 0 1 1 1.4 1.4L11.4 10l4.3 4.3a1 1 0 0 1-1.4 1.4L10 11.4l-4.3 4.3a1 1 0 0 1-1.4-1.4L8.6 10 4.3 5.7a1 1 0 0 1 0-1.4Z"/></svg>
      </button>
    </div>
    {%- if widget_style.bubbleLabel != blank -%}
      <button type="button" class="reelup-pop__label" data-reelup-pop-open tabindex="-1" aria-hidden="true">
        {{- widget_style.bubbleLabel | escape -}}
      </button>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Shoppable Videos",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Turns on every shoppable video block in your theme, plus the floating video if you've set one up. Appearance and content are managed in the app under Widgets."
    }
  ]
}
{% endschema %}
