{% doc %}
STORIES: ringed avatars in a row. Tapping one opens the full-screen story
viewer from that reel and auto-advances through the rest; rings of stories
the shopper has already watched turn grey (remembered in localStorage by
reel-story.js), the way shoppers expect from social apps. Scroll arrows
appear on pointer devices when the row overflows.

Self-sufficient: the schema loads reel-widgets.css and reel-loader.js, which
pulls in the viewer runtime when the app embed is off.

@example
{% content_for 'block', type: 'insta-stories', id: 'insta-stories' %}
{% enddoc %}

{% assign reel_namespace = 'app--404281098241' %}

{%- liquid
  assign widget = shop.metafields[reel_namespace].insta_stories_widget.value
  assign widget_style = widget.style
  assign reels = shop.metafields[reel_namespace].insta_stories_widget_reels.value
  assign target_product = block.settings.product | default: product

  assign show_widget = false
  if widget.published
    case widget.targetRule.type
      when 'all_products'
        assign show_widget = true
      when 'handles'
        if target_product and widget.targetRule.handles contains target_product.handle
          assign show_widget = true
        endif
      when 'collections'
        if collection and widget.targetRule.handles contains collection.handle
          assign show_widget = true
        elsif target_product
          for product_collection in target_product.collections
            if widget.targetRule.handles contains product_collection.handle
              assign show_widget = true
              break
            endif
          endfor
        endif
    endcase
  endif
  if widget.pageTypes.size > 0
    unless widget.pageTypes contains template.name
      assign show_widget = false
    endunless
  endif

  assign visible_count = 0
  if show_widget
    for reel in reels
      if reel.published.value and reel.config.value.hlsManifestUrl != blank
        assign visible_count = visible_count | plus: 1
      endif
    endfor
  endif

  assign show_caption = true
  if widget_style.showCaption == false
    assign show_caption = false
  endif

  assign ring_start = widget_style.accentColor | default: '#f58529'
  assign ring_end = widget_style.accentSecondaryColor | default: '#c13584'
  if widget_style.ringStyle == 'solid'
    assign ring_end = ring_start
  endif
-%}

{%- if visible_count > 0 -%}
  {%- render 'reel-config' -%}
  {%- capture wrapper_style -%}
    --awa-sv-avatar: {{ widget_style.triggerSize | default: 72 | times: 1 }}px;
    --awa-sv-ring-start: {{ ring_start | escape }};
    --awa-sv-ring-end: {{ ring_end | escape }};
    {%- if widget_style.textColor != blank %}--awa-sv-text: {{ widget_style.textColor | escape }};{% endif -%}
  {%- endcapture -%}
  <section
    class="awa-sv awa-sv-stories awa-sv-device--{{ widget.deviceVisibility | default: 'all' | escape }}"
    style="{{ wrapper_style | strip_newlines }}"
    {% if widget_style.heading != blank %}aria-label="{{ widget_style.heading | escape }}"{% endif %}
    {{ block.shopify_attributes }}
  >
    {%- if widget_style.heading != blank -%}
      <h2 class="awa-sv-heading">{{ widget_style.heading | escape }}</h2>
    {%- endif -%}
    <div class="awa-sv-strip__viewport awa-sv-stories__viewport">
      <ul class="awa-sv-stories__row" data-awa-sv-story-group data-awa-sv-strip role="list">
        {%- for reel in reels -%}
          {%- if reel.published.value and reel.config.value.hlsManifestUrl != blank -%}
            {%- liquid
              assign play_label = 'reels.play_label' | t
              if reel.title.value != blank
                assign play_label = 'reels.play_named_label' | t: title: reel.title.value
              endif
            -%}
            {%- render 'reel-video-schema', reel: reel -%}
            {%- capture avatar -%}
              <button type="button" class="awa-sv-trigger__button awa-sv-stories__avatar" aria-label="{{ play_label }}">
                <span class="awa-sv-stories__ring" aria-hidden="true"></span>
                <span class="awa-sv-stories__photo">
                  {%- if reel.config.value.posterUrl != blank -%}
                    {%- render 'reel-poster', url: reel.config.value.posterUrl, height: 200, width_attr: 160, height_attr: 160 -%}
                  {%- endif -%}
                </span>
              </button>
            {%- endcapture -%}
            <li class="awa-sv-stories__item">
              {%- render 'reel-trigger', reel: reel, style: widget_style, source: 'stories', inner: avatar, muted_default: true -%}
              {%- if show_caption and reel.title.value != blank -%}
                <span class="awa-sv-stories__label" aria-hidden="true">{{ reel.title.value | escape }}</span>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if visible_count > 1 -%}
        <button type="button" class="awa-sv-arrow awa-sv-arrow--prev" data-awa-sv-strip-prev aria-label="{{ 'reels.scroll_back_label' | t }}" hidden>
          {%- render 'reel-icon', name: 'chevron-left', size: 14 -%}
        </button>
        <button type="button" class="awa-sv-arrow awa-sv-arrow--next" data-awa-sv-strip-next aria-label="{{ 'reels.scroll_forward_label' | t }}" hidden>
          {%- render 'reel-icon', name: 'chevron-right', size: 14 -%}
        </button>
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="awa-sv awa-sv-placeholder" {{ block.shopify_attributes }}>{{ 'reels.editor_placeholder' | t }}</div>
{%- endif -%}

{% schema %}
{
  "name": "Stories",
  "target": "section",
  "javascript": "reel-loader.js",
  "stylesheet": "reel-widgets.css",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    {
      "type": "paragraph",
      "content": "Videos, ring colors and timing are set in the app under Widgets › Stories."
    }
  ]
}
{% endschema %}
