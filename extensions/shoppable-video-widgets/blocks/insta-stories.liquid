{% doc %}
STORIES: ringed avatars in a row. Tapping one opens the full-screen story
viewer from that reel and auto-advances through the rest; rings of stories
the shopper has already watched turn grey (remembered in localStorage by
reel-story.js), the way shoppers expect from social apps.

@example
{% content_for 'block', type: 'insta-stories', id: 'insta-stories' %}
{% enddoc %}

{{ 'reel-widgets.css' | asset_url | stylesheet_tag }}

{% assign reel_namespace = 'app--404281098241' %}

{%- liquid
  assign widget = shop.metafields[reel_namespace].insta_stories_widget.value
  assign widget_style = widget.style
  assign reels = shop.metafields[reel_namespace].insta_stories_widget_reels.value

  assign show_widget = false
  if widget.published
    case widget.targetRule.type
      when 'all_products'
        assign show_widget = true
      when 'handles'
        if product and widget.targetRule.handles contains product.handle
          assign show_widget = true
        endif
      when 'collections'
        for collection in product.collections
          if widget.targetRule.handles contains collection.handle
            assign show_widget = true
            break
          endif
        endfor
    endcase
  endif
  if widget.pageTypes.size > 0
    unless widget.pageTypes contains template.name
      assign show_widget = false
    endunless
  endif

  assign visible_count = 0
  if show_widget
    for reel in reels
      if reel.published.value and reel.config.value.hlsManifestUrl != blank
        assign visible_count = visible_count | plus: 1
      endif
    endfor
  endif

  assign show_caption = true
  if widget_style.showCaption == false
    assign show_caption = false
  endif

  assign ring_start = widget_style.accentColor | default: '#f58529'
  assign ring_end = widget_style.accentSecondaryColor | default: '#c13584'
  if widget_style.ringStyle == 'solid'
    assign ring_end = ring_start
  endif
-%}

{%- if visible_count > 0 -%}
  {%- capture wrapper_style -%}
    --ru-avatar: {{ widget_style.triggerSize | default: 72 }}px;
    --ru-ring-start: {{ ring_start }};
    --ru-ring-end: {{ ring_end }};
    {%- if widget_style.textColor != blank %}--ru-text: {{ widget_style.textColor }};{% endif -%}
  {%- endcapture -%}
  <section
    class="reelup reelup-stories reelup-device--{{ widget.deviceVisibility | default: 'all' }}"
    style="{{ wrapper_style | strip_newlines }}"
    {% if widget_style.heading != blank %}aria-label="{{ widget_style.heading | escape }}"{% endif %}
    {{ block.shopify_attributes }}
  >
    {%- if widget_style.heading != blank -%}
      <h2 class="reelup-heading">{{ widget_style.heading | escape }}</h2>
    {%- endif -%}
    <ul class="reelup-stories__row" data-reelup-story-group role="list">
      {%- for reel in reels -%}
        {%- if reel.published.value and reel.config.value.hlsManifestUrl != blank -%}
          {%- render 'reel-video-schema', reel: reel -%}
          {%- capture avatar -%}
            <button type="button" class="reelup-trigger__button reelup-stories__avatar" aria-label="{{ 'reels.play_named_label' | t: title: reel.title.value | escape }}">
              <span class="reelup-stories__ring" aria-hidden="true"></span>
              <span class="reelup-stories__photo">
                {%- if reel.config.value.posterUrl != blank -%}
                  <img class="reelup-trigger__poster" src="{{ reel.config.value.posterUrl | escape }}" alt="" loading="lazy" width="160" height="160">
                {%- endif -%}
              </span>
            </button>
          {%- endcapture -%}
          <li class="reelup-stories__item">
            {%- render 'reel-trigger', reel: reel, style: widget_style, inner: avatar, muted_default: true -%}
            {%- if show_caption -%}
              <span class="reelup-stories__label" aria-hidden="true">{{ reel.title.value | escape }}</span>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Stories",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    {
      "type": "paragraph",
      "content": "Videos, ring colors and timing are set in the app under Widgets › Stories. Needs the Shoppable Videos app embed turned on."
    }
  ]
}
{% endschema %}
