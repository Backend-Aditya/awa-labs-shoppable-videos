{% doc %}
CAROUSEL: a fanned deck of videos. The centre card leads (play button,
title), neighbours tuck behind it; arrows, dots, swipe or the arrow keys
move through the deck, and tapping the centre card opens the viewer with
next/previous through the whole set. "Slider" and "Grid" are plainer
alternates for themes where a deck doesn't fit. Without JS the deck falls
back to a horizontally scrolling row.

@example
{% content_for 'block', type: 'stacked-carousel', id: 'stacked-carousel' %}
{% enddoc %}

{{ 'reel-widgets.css' | asset_url | stylesheet_tag }}

{% assign reel_namespace = 'app--404281098241' %}

{%- liquid
  assign widget = shop.metafields[reel_namespace].stacked_carousel_widget.value
  assign widget_style = widget.style
  assign reels = shop.metafields[reel_namespace].stacked_carousel_widget_reels.value

  assign show_widget = false
  if widget.published
    case widget.targetRule.type
      when 'all_products'
        assign show_widget = true
      when 'handles'
        if product and widget.targetRule.handles contains product.handle
          assign show_widget = true
        endif
      when 'collections'
        for collection in product.collections
          if widget.targetRule.handles contains collection.handle
            assign show_widget = true
            break
          endif
        endfor
    endcase
  endif
  if widget.pageTypes.size > 0
    unless widget.pageTypes contains template.name
      assign show_widget = false
    endunless
  endif

  assign visible_count = 0
  if show_widget
    for reel in reels
      if reel.published.value and reel.config.value.hlsManifestUrl != blank
        assign visible_count = visible_count | plus: 1
      endif
    endfor
  endif

  assign layout = widget_style.layoutMode | default: 'stack'
  if layout == 'stack' and visible_count < 3
    assign layout = 'carousel'
  endif

  assign show_caption = true
  if widget_style.showCaption == false
    assign show_caption = false
  endif

  case widget_style.cornerStyle
    when 'sharp'
      assign radius = '0px'
    when 'rounded'
      assign radius = '10px'
    else
      assign radius = '18px'
  endcase
-%}

{%- if visible_count > 0 -%}
  {%- capture wrapper_style -%}
    --ru-radius: {{ radius }};
    --ru-columns: {{ widget_style.columns | default: 4 }};
    {%- if widget_style.accentColor != blank %}--ru-accent: {{ widget_style.accentColor }};{% endif -%}
    {%- if widget_style.backgroundColor != blank %}--ru-bg: {{ widget_style.backgroundColor }};{% endif -%}
    {%- if widget_style.textColor != blank %}--ru-text: {{ widget_style.textColor }};{% endif -%}
  {%- endcapture -%}
  <section
    class="reelup reelup-deck reelup-deck--{{ layout }} reelup-shadow--{{ widget_style.shadowPreset | default: 'bold' }} reelup-device--{{ widget.deviceVisibility | default: 'all' }}{% if widget_style.backgroundColor != blank %} reelup--filled{% endif %}"
    style="{{ wrapper_style | strip_newlines }}"
    {% if layout == 'stack' %}data-reelup-deck aria-roledescription="carousel"{% endif %}
    {% if widget_style.heading != blank %}aria-label="{{ widget_style.heading | escape }}"{% endif %}
    {{ block.shopify_attributes }}
  >
    {%- if widget_style.heading != blank -%}
      <h2 class="reelup-heading reelup-heading--center">{{ widget_style.heading | escape }}</h2>
    {%- endif -%}
    <ul class="reelup-deck__stage" data-reelup-group role="list">
      {%- for reel in reels -%}
        {%- if reel.published.value and reel.config.value.hlsManifestUrl != blank -%}
          {%- render 'reel-video-schema', reel: reel -%}
          {%- capture card -%}
            <button type="button" class="reelup-trigger__button reelup-deck__poster" aria-label="{{ 'reels.play_named_label' | t: title: reel.title.value | escape }}">
              {%- if reel.config.value.posterUrl != blank -%}
                <img class="reelup-trigger__poster" src="{{ reel.config.value.posterUrl | escape }}" alt="" loading="lazy" width="480" height="854">
              {%- endif -%}
              <span class="reelup-deck__play" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 10 10" focusable="false"><path fill="currentColor" d="M2 1.2v7.6a.5.5 0 0 0 .76.43l6.1-3.8a.5.5 0 0 0 0-.86L2.76.77A.5.5 0 0 0 2 1.2Z"/></svg>
              </span>
              {%- if show_caption -%}
                <span class="reelup-deck__caption">
                  <span class="reelup-deck__title">{{ reel.title.value | escape }}</span>
                  {%- assign product_count = reel.tagged_products.value.size | default: 0 -%}
                  {%- if product_count > 0 -%}
                    <span class="reelup-deck__meta">{{ 'reels.products_count' | t: count: product_count }}</span>
                  {%- endif -%}
                </span>
              {%- endif -%}
              {%- if widget_style.showDuration -%}{%- render 'reel-duration', reel: reel -%}{%- endif -%}
            </button>
          {%- endcapture -%}
          <li class="reelup-deck__card" data-reelup-deck-card>
            {%- render 'reel-trigger', reel: reel, style: widget_style, inner: card, muted_default: true, autoplay_default: true -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if layout == 'stack' -%}
      <div class="reelup-deck__nav">
        <button type="button" class="reelup-deck__arrow" data-reelup-deck-prev aria-label="{{ 'reels.previous_label' | t }}">
          <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.7 4.3a1 1 0 0 1 0 1.4L8.42 10l4.3 4.3a1 1 0 0 1-1.42 1.4l-5-5a1 1 0 0 1 0-1.4l5-5a1 1 0 0 1 1.42 0Z"/></svg>
        </button>
        <div class="reelup-deck__dots" data-reelup-deck-dots aria-hidden="true">
          {%- for i in (1..visible_count) -%}<span></span>{%- endfor -%}
        </div>
        <button type="button" class="reelup-deck__arrow" data-reelup-deck-next aria-label="{{ 'reels.next_label' | t }}">
          <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M7.3 15.7a1 1 0 0 1 0-1.4l4.28-4.3-4.3-4.3a1 1 0 1 1 1.42-1.4l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 0 1-1.42 0Z"/></svg>
        </button>
      </div>
      <p class="reelup-visually-hidden" aria-live="polite" data-reelup-deck-status></p>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Stacked carousel",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    {
      "type": "paragraph",
      "content": "Videos, layout and colors are set in the app under Widgets › Stacked carousel. Needs the Shoppable Videos app embed turned on."
    }
  ]
}
{% endschema %}
