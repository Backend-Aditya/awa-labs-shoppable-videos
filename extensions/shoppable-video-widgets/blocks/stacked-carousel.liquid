{% doc %}
CAROUSEL: a fanned deck of videos. The centre card leads (play button,
title), neighbours tuck behind it; arrows, dots, swipe or the arrow keys
move through the deck, and tapping the centre card opens the viewer with
next/previous through the whole set. "Slider" and "Grid" are plainer
alternates for themes where a deck doesn't fit. Without JS the deck falls
back to a horizontally scrolling row (same height, so no layout shift when
JS takes over).

Self-sufficient: the schema loads reel-widgets.css and reel-loader.js, which
pulls in the viewer runtime when the app embed is off.

@example
{% content_for 'block', type: 'stacked-carousel', id: 'stacked-carousel' %}
{% enddoc %}

{% assign reel_namespace = 'app--404281098241' %}

{%- liquid
  assign widget = shop.metafields[reel_namespace].stacked_carousel_widget.value
  assign widget_style = widget.style
  assign reels = shop.metafields[reel_namespace].stacked_carousel_widget_reels.value
  assign target_product = block.settings.product | default: product

  assign show_widget = false
  if widget.published
    case widget.targetRule.type
      when 'all_products'
        assign show_widget = true
      when 'handles'
        if target_product and widget.targetRule.handles contains target_product.handle
          assign show_widget = true
        endif
      when 'collections'
        if collection and widget.targetRule.handles contains collection.handle
          assign show_widget = true
        elsif target_product
          for product_collection in target_product.collections
            if widget.targetRule.handles contains product_collection.handle
              assign show_widget = true
              break
            endif
          endfor
        endif
    endcase
  endif
  if widget.pageTypes.size > 0
    unless widget.pageTypes contains template.name
      assign show_widget = false
    endunless
  endif

  assign visible_count = 0
  if show_widget
    for reel in reels
      if reel.published.value and reel.config.value.hlsManifestUrl != blank
        assign visible_count = visible_count | plus: 1
      endif
    endfor
  endif

  assign layout = widget_style.layoutMode | default: 'stack'
  if layout != 'grid' and layout != 'carousel'
    assign layout = 'stack'
  endif
  if layout == 'stack' and visible_count < 3
    assign layout = 'carousel'
  endif

  assign show_caption = true
  if widget_style.showCaption == false
    assign show_caption = false
  endif

  # How each card presents its lead product (see WidgetStyleConfig.cardTemplate).
  assign card_template = widget_style.cardTemplate | default: 'title'
  assign card_below = false
  case card_template
    when 'classic', 'modern', 'vibrant'
      assign card_below = true
    when 'overlay'
    else
      assign card_template = 'title'
  endcase
  assign show_play = true
  if widget_style.showPlayIcon == false
    assign show_play = false
  endif
  assign show_price = true
  if widget_style.showPrice == false
    assign show_price = false
  endif
  assign show_card_badge = false
  if widget_style.showCardBadge == true
    assign show_card_badge = true
  endif

  case widget_style.cornerStyle
    when 'sharp'
      assign radius = '0px'
    when 'rounded'
      assign radius = '10px'
    else
      assign radius = '18px'
  endcase

  assign deck_label = widget_style.heading | escape
  if deck_label == blank
    assign deck_label = 'reels.videos_label' | t
  endif
-%}

{%- if visible_count > 0 -%}
  {%- render 'reel-config' -%}
  {%- capture wrapper_style -%}
    --awa-sv-radius: {{ radius }};
    --awa-sv-columns: {{ widget_style.columns | default: 4 | times: 1 }};
    {%- if widget_style.accentColor != blank %}--awa-sv-accent: {{ widget_style.accentColor | escape }}; --awa-sv-play: {{ widget_style.accentColor | escape }}; --awa-sv-eyebrow: {{ widget_style.accentColor | escape }};{% endif -%}
    {%- if widget_style.backgroundColor != blank %}--awa-sv-bg: {{ widget_style.backgroundColor | escape }};{% endif -%}
    {%- if widget_style.textColor != blank %}--awa-sv-text: {{ widget_style.textColor | escape }};{% endif -%}
    {%- if widget_style.badgeColor != blank %}--awa-sv-card-badge: {{ widget_style.badgeColor | escape }};{% endif -%}
    {%- if widget_style.ctaColor != blank %}--awa-sv-cta: {{ widget_style.ctaColor | escape }};{% endif -%}
    {%- if widget_style.ctaTextColor != blank %}--awa-sv-cta-text: {{ widget_style.ctaTextColor | escape }};{% endif -%}
    {%- comment -%} Sizing and spacing: only what the merchant set; the rest keeps the responsive defaults. {%- endcomment -%}
    {%- if widget_style.triggerSize %}--awa-sv-card-w: {{ widget_style.triggerSize | times: 1 }}px;{% endif -%}
    {%- if widget_style.eyebrowSize %}--awa-sv-eyebrow-size: {{ widget_style.eyebrowSize | times: 1 }}px;{% endif -%}
    {%- if widget_style.headingSize %}--awa-sv-heading-size: {{ widget_style.headingSize | times: 1 }}px;{% endif -%}
    {%- if widget_style.subheadingSize %}--awa-sv-sub-size: {{ widget_style.subheadingSize | times: 1 }}px;{% endif -%}
    {%- if widget_style.cardTextSize %}--awa-sv-card-text: {{ widget_style.cardTextSize | times: 1 }}px;{% endif -%}
    {%- if widget_style.cardGap != nil %}--awa-sv-gap: {{ widget_style.cardGap | times: 1 }}px;{% endif -%}
    {%- if widget_style.sectionPaddingY != nil %}--awa-sv-pad-y: {{ widget_style.sectionPaddingY | times: 1 }}px;{% endif -%}
    {%- if widget_style.sectionPaddingX != nil %}--awa-sv-pad-x: {{ widget_style.sectionPaddingX | times: 1 }}px;{% endif -%}
  {%- endcapture -%}
  <section
    class="awa-sv awa-sv-deck awa-sv-deck--{{ layout }} awa-sv-deck--card-{{ card_template }} awa-sv-shadow--{{ widget_style.shadowPreset | default: 'bold' | escape }} awa-sv-device--{{ widget.deviceVisibility | default: 'all' | escape }}{% if widget_style.backgroundColor != blank %} awa-sv--filled{% endif %}"
    style="{{ wrapper_style | strip_newlines }}"
    {% if layout == 'stack' -%}
      data-awa-sv-deck aria-roledescription="{{ 'reels.carousel_label' | t }}"
      data-status-format="{{ 'reels.position_label' | t: current: '__CURRENT__', total: '__TOTAL__' }}"
    {%- endif %}
    aria-label="{{ deck_label }}"
    {{ block.shopify_attributes }}
  >
    {%- if widget_style.eyebrow != blank or widget_style.heading != blank or widget_style.subheading != blank -%}
      <header class="awa-sv-deck__header">
        {%- if widget_style.eyebrow != blank -%}
          <p class="awa-sv-deck__eyebrow">{{ widget_style.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if widget_style.heading != blank -%}
          <h2 class="awa-sv-heading awa-sv-heading--center">{{ widget_style.heading | escape }}</h2>
        {%- endif -%}
        {%- if widget_style.subheading != blank -%}
          <p class="awa-sv-deck__subheading">{{ widget_style.subheading | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}
    <div class="awa-sv-deck__viewport awa-sv-strip__viewport">
      <ul class="awa-sv-deck__stage" data-awa-sv-group {% if layout == 'carousel' %}data-awa-sv-strip{% endif %} role="list">
        {%- assign rendered = 0 -%}
        {%- for reel in reels -%}
          {%- if reel.published.value and reel.config.value.hlsManifestUrl != blank -%}
            {%- assign rendered = rendered | plus: 1 -%}
            {%- liquid
              assign play_label = 'reels.play_label' | t
              if reel.title.value != blank
                assign play_label = 'reels.play_named_label' | t: title: reel.title.value
              endif
              # The stack shows card 2 in front; the slider/grid card 1.
              assign lead_index = 1
              if layout == 'stack'
                assign lead_index = 2
              endif
              assign first = false
              if rendered == lead_index
                assign first = true
              endif
            -%}
            {%- render 'reel-video-schema', reel: reel -%}
            {%- liquid
              assign lead = reel.tagged_products.value | first
              assign lead_variant = lead.selected_or_first_available_variant
              assign card_discount = 0
              if show_card_badge and lead_variant.compare_at_price > lead_variant.price
                assign half = lead_variant.compare_at_price | divided_by: 2
                assign card_discount = lead_variant.compare_at_price | minus: lead_variant.price | times: 100 | plus: half | divided_by: lead_variant.compare_at_price
              endif
            -%}
            {%- capture lead_line -%}
              {%- if lead -%}
                <span class="awa-sv-deck__product">
                  {%- if lead.featured_image and card_template != 'modern' -%}
                    <img class="awa-sv-deck__thumb" src="{{ lead.featured_image | image_url: width: 96 }}" alt="" loading="lazy" width="48" height="48">
                  {%- endif -%}
                  <span class="awa-sv-deck__product-text">
                    <span class="awa-sv-deck__product-title">{{ lead.title | escape }}</span>
                    {%- if show_price and lead_variant -%}
                      <span class="awa-sv-deck__product-price">
                        <span>{{ lead_variant.price | money }}</span>
                        {%- if lead_variant.compare_at_price > lead_variant.price -%}<s>{{ lead_variant.compare_at_price | money }}</s>{%- endif -%}
                      </span>
                    {%- endif -%}
                  </span>
                </span>
              {%- elsif reel.title.value != blank -%}
                <span class="awa-sv-deck__product"><span class="awa-sv-deck__product-text"><span class="awa-sv-deck__product-title">{{ reel.title.value | escape }}</span></span></span>
              {%- endif -%}
            {%- endcapture -%}
            {%- capture card -%}
              <button type="button" class="awa-sv-trigger__button awa-sv-deck__poster" aria-label="{{ play_label }}">
                {%- if reel.config.value.posterUrl != blank -%}
                  {%- render 'reel-poster', url: reel.config.value.posterUrl, height: 800, width_attr: 480, height_attr: 854, srcset_heights: '480,800,1200', sizes: 'min(280px, 58vw)', eager: first, priority: first -%}
                {%- endif -%}
                {%- if card_discount > 0 -%}
                  <span class="awa-sv-deck__badge">{{ 'reels.percent_off' | t: percent: card_discount }}</span>
                {%- endif -%}
                {%- if show_play -%}
                  <span class="awa-sv-deck__play awa-sv-play" aria-hidden="true">
                    {%- render 'reel-icon', name: 'play', size: 18 -%}
                  </span>
                {%- endif -%}
                {%- if card_template == 'title' and show_caption -%}
                  <span class="awa-sv-deck__caption">
                    {%- if reel.title.value != blank -%}<span class="awa-sv-deck__title">{{ reel.title.value | escape }}</span>{%- endif -%}
                    {%- assign product_count = reel.tagged_products.value.size | default: 0 -%}
                    {%- if product_count > 0 -%}
                      <span class="awa-sv-deck__meta">{{ 'reels.products_count' | t: count: product_count }}</span>
                    {%- endif -%}
                  </span>
                {%- elsif card_template == 'overlay' and lead_line != blank -%}
                  <span class="awa-sv-deck__overlay">{{ lead_line }}</span>
                {%- endif -%}
                {%- if widget_style.showDuration -%}{%- render 'reel-duration', reel: reel -%}{%- endif -%}
              </button>
              {%- if card_below -%}
                {%- comment -%}
                  Under the video: the same reel, so a click anywhere here opens it
                  too (reel-trigger.js, data-awa-sv-open). The poster button above
                  is the keyboard stop; this repeats it for pointers.
                {%- endcomment -%}
                <div class="awa-sv-deck__info" data-awa-sv-open>
                  {{- lead_line -}}
                  {%- if card_template != 'classic' -%}
                    <span class="awa-sv-deck__shop" aria-hidden="true">{{ 'reels.shop_now' | t }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endcapture -%}
            <li class="awa-sv-deck__card" data-awa-sv-deck-card>
              {%- render 'reel-trigger', reel: reel, style: widget_style, source: 'carousel', inner: card, muted_default: true, autoplay_default: true, details_default: true, image_size_default: 'large', corners_default: 'square' -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if layout == 'carousel' and visible_count > 1 -%}
        <button type="button" class="awa-sv-arrow awa-sv-arrow--prev" data-awa-sv-strip-prev aria-label="{{ 'reels.scroll_back_label' | t }}" hidden>
          {%- render 'reel-icon', name: 'chevron-left', size: 16 -%}
        </button>
        <button type="button" class="awa-sv-arrow awa-sv-arrow--next" data-awa-sv-strip-next aria-label="{{ 'reels.scroll_forward_label' | t }}" hidden>
          {%- render 'reel-icon', name: 'chevron-right', size: 16 -%}
        </button>
      {%- endif -%}
    </div>
    {%- if layout == 'stack' -%}
      <div class="awa-sv-deck__nav">
        <button type="button" class="awa-sv-deck__arrow" data-awa-sv-deck-prev aria-label="{{ 'reels.previous_label' | t }}">
          {%- render 'reel-icon', name: 'chevron-left', size: 16 -%}
        </button>
        <div class="awa-sv-deck__dots" data-awa-sv-deck-dots aria-hidden="true">
          {%- for i in (1..visible_count) -%}<span></span>{%- endfor -%}
        </div>
        <button type="button" class="awa-sv-deck__arrow" data-awa-sv-deck-next aria-label="{{ 'reels.next_label' | t }}">
          {%- render 'reel-icon', name: 'chevron-right', size: 16 -%}
        </button>
      </div>
      <p class="awa-sv-visually-hidden awa-sv-deck__status" aria-live="polite" aria-atomic="true" data-awa-sv-deck-status></p>
    {%- endif -%}
  </section>
{%- elsif request.design_mode -%}
  <div class="awa-sv awa-sv-placeholder" {{ block.shopify_attributes }}>{{ 'reels.editor_placeholder' | t }}</div>
{%- endif -%}

{% schema %}
{
  "name": "Stacked carousel",
  "target": "section",
  "javascript": "reel-loader.js",
  "stylesheet": "reel-widgets.css",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    {
      "type": "paragraph",
      "content": "Videos, layout and colors are set in the app under Widgets › Stacked carousel."
    }
  ]
}
{% endschema %}
