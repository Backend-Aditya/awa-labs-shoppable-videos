{% doc %}
CAROUSEL: a fanned deck of videos. The centre card leads (play button,
title), neighbours tuck behind it; arrows, dots, swipe or the arrow keys
move through the deck, and tapping the centre card opens the viewer with
next/previous through the whole set. "Slider" and "Grid" are plainer
alternates for themes where a deck doesn't fit. Without JS the deck falls
back to a horizontally scrolling row (same height, so no layout shift when
JS takes over).

Self-sufficient: the schema loads reel-widgets.css and reel-loader.js, which
pulls in the viewer runtime when the app embed is off.

@example
{% content_for 'block', type: 'stacked-carousel', id: 'stacked-carousel' %}
{% enddoc %}

{% assign reel_namespace = 'app--404281098241' %}

{%- liquid
  assign widget = shop.metafields[reel_namespace].stacked_carousel_widget.value
  assign widget_style = widget.style
  assign reels = shop.metafields[reel_namespace].stacked_carousel_widget_reels.value
  assign target_product = block.settings.product | default: product

  assign show_widget = false
  if widget.published
    case widget.targetRule.type
      when 'all_products'
        assign show_widget = true
      when 'handles'
        if target_product and widget.targetRule.handles contains target_product.handle
          assign show_widget = true
        endif
      when 'collections'
        if collection and widget.targetRule.handles contains collection.handle
          assign show_widget = true
        elsif target_product
          for product_collection in target_product.collections
            if widget.targetRule.handles contains product_collection.handle
              assign show_widget = true
              break
            endif
          endfor
        endif
    endcase
  endif
  if widget.pageTypes.size > 0
    unless widget.pageTypes contains template.name
      assign show_widget = false
    endunless
  endif

  assign visible_count = 0
  if show_widget
    for reel in reels
      if reel.published.value and reel.config.value.hlsManifestUrl != blank
        assign visible_count = visible_count | plus: 1
      endif
    endfor
  endif

  assign layout = widget_style.layoutMode | default: 'stack'
  if layout != 'grid' and layout != 'carousel'
    assign layout = 'stack'
  endif
  if layout == 'stack' and visible_count < 3
    assign layout = 'carousel'
  endif

  assign show_caption = true
  if widget_style.showCaption == false
    assign show_caption = false
  endif

  case widget_style.cornerStyle
    when 'sharp'
      assign radius = '0px'
    when 'rounded'
      assign radius = '10px'
    else
      assign radius = '18px'
  endcase

  assign deck_label = widget_style.heading | escape
  if deck_label == blank
    assign deck_label = 'reels.videos_label' | t
  endif
-%}

{%- if visible_count > 0 -%}
  {%- render 'reel-config' -%}
  {%- capture wrapper_style -%}
    --ru-radius: {{ radius }};
    --ru-columns: {{ widget_style.columns | default: 4 | times: 1 }};
    {%- if widget_style.accentColor != blank %}--ru-accent: {{ widget_style.accentColor | escape }}; --ru-play: {{ widget_style.accentColor | escape }};{% endif -%}
    {%- if widget_style.backgroundColor != blank %}--ru-bg: {{ widget_style.backgroundColor | escape }};{% endif -%}
    {%- if widget_style.textColor != blank %}--ru-text: {{ widget_style.textColor | escape }};{% endif -%}
  {%- endcapture -%}
  <section
    class="reelup reelup-deck reelup-deck--{{ layout }} reelup-shadow--{{ widget_style.shadowPreset | default: 'bold' | escape }} reelup-device--{{ widget.deviceVisibility | default: 'all' | escape }}{% if widget_style.backgroundColor != blank %} reelup--filled{% endif %}"
    style="{{ wrapper_style | strip_newlines }}"
    {% if layout == 'stack' -%}
      data-reelup-deck aria-roledescription="{{ 'reels.carousel_label' | t }}"
      data-status-format="{{ 'reels.position_label' | t: current: '__CURRENT__', total: '__TOTAL__' }}"
    {%- endif %}
    aria-label="{{ deck_label }}"
    {{ block.shopify_attributes }}
  >
    {%- if widget_style.heading != blank -%}
      <h2 class="reelup-heading reelup-heading--center">{{ widget_style.heading | escape }}</h2>
    {%- endif -%}
    <div class="reelup-deck__viewport reelup-strip__viewport">
      <ul class="reelup-deck__stage" data-reelup-group {% if layout == 'carousel' %}data-reelup-strip{% endif %} role="list">
        {%- assign rendered = 0 -%}
        {%- for reel in reels -%}
          {%- if reel.published.value and reel.config.value.hlsManifestUrl != blank -%}
            {%- assign rendered = rendered | plus: 1 -%}
            {%- liquid
              assign play_label = 'reels.play_label' | t
              if reel.title.value != blank
                assign play_label = 'reels.play_named_label' | t: title: reel.title.value
              endif
              # The stack shows card 2 in front; the slider/grid card 1.
              assign lead_index = 1
              if layout == 'stack'
                assign lead_index = 2
              endif
              assign first = false
              if rendered == lead_index
                assign first = true
              endif
            -%}
            {%- render 'reel-video-schema', reel: reel -%}
            {%- capture card -%}
              <button type="button" class="reelup-trigger__button reelup-deck__poster" aria-label="{{ play_label }}">
                {%- if reel.config.value.posterUrl != blank -%}
                  {%- render 'reel-poster', url: reel.config.value.posterUrl, height: 800, width_attr: 480, height_attr: 854, srcset_heights: '480,800,1200', sizes: 'min(280px, 58vw)', eager: first, priority: first -%}
                {%- endif -%}
                <span class="reelup-deck__play" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 10 10" focusable="false"><path fill="currentColor" d="M2 1.2v7.6a.5.5 0 0 0 .76.43l6.1-3.8a.5.5 0 0 0 0-.86L2.76.77A.5.5 0 0 0 2 1.2Z"/></svg>
                </span>
                {%- if show_caption -%}
                  <span class="reelup-deck__caption">
                    {%- if reel.title.value != blank -%}<span class="reelup-deck__title">{{ reel.title.value | escape }}</span>{%- endif -%}
                    {%- assign product_count = reel.tagged_products.value.size | default: 0 -%}
                    {%- if product_count > 0 -%}
                      <span class="reelup-deck__meta">{{ 'reels.products_count' | t: count: product_count }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
                {%- if widget_style.showDuration -%}{%- render 'reel-duration', reel: reel -%}{%- endif -%}
              </button>
            {%- endcapture -%}
            <li class="reelup-deck__card" data-reelup-deck-card>
              {%- render 'reel-trigger', reel: reel, style: widget_style, inner: card, muted_default: true, autoplay_default: true -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if layout == 'carousel' and visible_count > 1 -%}
        <button type="button" class="reelup-arrow reelup-arrow--prev" data-reelup-strip-prev aria-label="{{ 'reels.scroll_back_label' | t }}" hidden>
          <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.7 4.3a1 1 0 0 1 0 1.4L8.42 10l4.3 4.3a1 1 0 0 1-1.42 1.4l-5-5a1 1 0 0 1 0-1.4l5-5a1 1 0 0 1 1.42 0Z"/></svg>
        </button>
        <button type="button" class="reelup-arrow reelup-arrow--next" data-reelup-strip-next aria-label="{{ 'reels.scroll_forward_label' | t }}" hidden>
          <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M7.3 15.7a1 1 0 0 1 0-1.4l4.28-4.3-4.3-4.3a1 1 0 1 1 1.42-1.4l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 0 1-1.42 0Z"/></svg>
        </button>
      {%- endif -%}
    </div>
    {%- if layout == 'stack' -%}
      <div class="reelup-deck__nav">
        <button type="button" class="reelup-deck__arrow" data-reelup-deck-prev aria-label="{{ 'reels.previous_label' | t }}">
          <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.7 4.3a1 1 0 0 1 0 1.4L8.42 10l4.3 4.3a1 1 0 0 1-1.42 1.4l-5-5a1 1 0 0 1 0-1.4l5-5a1 1 0 0 1 1.42 0Z"/></svg>
        </button>
        <div class="reelup-deck__dots" data-reelup-deck-dots aria-hidden="true">
          {%- for i in (1..visible_count) -%}<span></span>{%- endfor -%}
        </div>
        <button type="button" class="reelup-deck__arrow" data-reelup-deck-next aria-label="{{ 'reels.next_label' | t }}">
          <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M7.3 15.7a1 1 0 0 1 0-1.4l4.28-4.3-4.3-4.3a1 1 0 1 1 1.42-1.4l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 0 1-1.42 0Z"/></svg>
        </button>
      </div>
      <p class="reelup-visually-hidden reelup-deck__status" aria-live="polite" aria-atomic="true" data-reelup-deck-status></p>
    {%- endif -%}
  </section>
{%- elsif request.design_mode -%}
  <div class="reelup reelup-placeholder" {{ block.shopify_attributes }}>{{ 'reels.editor_placeholder' | t }}</div>
{%- endif -%}

{% schema %}
{
  "name": "Stacked carousel",
  "target": "section",
  "javascript": "reel-loader.js",
  "stylesheet": "reel-widgets.css",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    {
      "type": "paragraph",
      "content": "Videos, layout and colors are set in the app under Widgets › Stacked carousel."
    }
  ]
}
{% endschema %}
