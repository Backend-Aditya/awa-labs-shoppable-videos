{% doc %}
Renders the widget's curated reels as a responsive grid of click-to-open
triggers (CAROUSEL widget kind). Same widget-gating pattern as
product-page-reels.liquid. Clicking a card opens the shared reel
lightbox with the video and any tagged products.
@example
{% content_for 'block', type: 'stacked-carousel', id: 'stacked-carousel' %}
{% enddoc %}

{{ 'reel-lightbox.css' | asset_url | stylesheet_tag }}
{{ 'stacked-carousel.css' | asset_url | stylesheet_tag }}

{% assign reel_namespace = 'app--404281098241' %}

{% assign widget_field = shop.metafields[reel_namespace].stacked_carousel_widget %}
{% assign widget_style = widget_field.value.style %}

{% case widget_style.cornerStyle %}
  {% when 'sharp' %}
    {% assign corner_radius_px = '0px' %}
  {% when 'soft' %}
    {% assign corner_radius_px = '20px' %}
  {% else %}
    {% assign corner_radius_px = '12px' %}
{% endcase %}

{% assign style_columns = widget_style.columns | default: 3 %}

{% capture wrapper_style %}
  --reelup-corner-radius: {{ corner_radius_px }};
  --reelup-columns: {{ style_columns }};
  {% unless widget_style.accentColor == blank %}
    --reelup-accent-color: {{ widget_style.accentColor }};
    --reelup-accent-hover-color: {{ widget_style.accentColor | color_darken: 15 }};
  {% endunless %}
  {% unless widget_style.backgroundColor == blank %}
    --reelup-bg-color: {{ widget_style.backgroundColor }};
  {% endunless %}
  {% unless widget_style.textColor == blank %}
    --reelup-text-color: {{ widget_style.textColor }};
  {% endunless %}
{% endcapture %}

{% capture cta_hover_color %}
  {% unless widget_style.ctaColor == blank %}{{ widget_style.ctaColor | color_lighten: 15 }}{% endunless %}
{% endcapture %}

{% assign style_show_price = true %}
{% if widget_style.showPrice == false %}{% assign style_show_price = false %}{% endif %}
{% assign style_show_title_overlay = true %}
{% if widget_style.showTitleOverlay == false %}{% assign style_show_title_overlay = false %}{% endif %}
{% assign style_muted_default = true %}
{% if widget_style.mutedDefault == false %}{% assign style_muted_default = false %}{% endif %}
{% assign style_loop = false %}
{% if widget_style.loop %}{% assign style_loop = true %}{% endif %}

{% assign layout_class = 'reelup-layout--carousel' %}
{% if widget_style.layoutMode == 'grid' %}{% assign layout_class = 'reelup-layout--grid' %}{% endif %}

{% assign shadow_class = 'reelup-shadow--none' %}
{% if widget_style.shadowPreset == 'soft' or widget_style.shadowPreset == 'bold' %}
  {% assign shadow_class = 'reelup-shadow--' | append: widget_style.shadowPreset %}
{% endif %}

{% assign visibility_class = '' %}
{% if widget_field.value.deviceVisibility == 'desktop' %}
  {% assign visibility_class = 'reelup-hide-mobile' %}
{% elsif widget_field.value.deviceVisibility == 'mobile' %}
  {% assign visibility_class = 'reelup-hide-desktop' %}
{% endif %}

{% assign widget_matches_product = false %}
{% if widget_field.value.published %}
  {% if widget_field.value.targetRule.type == "all_products" %}
    {% assign widget_matches_product = true %}
  {% elsif widget_field.value.targetRule.type == "handles" and widget_field.value.targetRule.handles contains product.handle %}
    {% assign widget_matches_product = true %}
  {% elsif widget_field.value.targetRule.type == "collections" %}
    {% for collection in product.collections %}
      {% if widget_field.value.targetRule.handles contains collection.handle %}
        {% assign widget_matches_product = true %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

{% assign reels_field = shop.metafields[reel_namespace].stacked_carousel_widget_reels %}

{% assign visible_count = 0 %}
{% if widget_matches_product %}
  {% for reel in reels_field.value %}
    {% if reel.published.value and reel.config.value.cloudflareStreamUid != blank and reel.config.value.hlsManifestUrl != blank %}
      {% assign visible_count = visible_count | plus: 1 %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if visible_count > 0 %}
  {% unless widget_style.heading == blank %}
    <h2 class="reelup-widget-heading"{% unless widget_style.textColor == blank %} style="color: {{ widget_style.textColor }};"{% endunless %}>{{ widget_style.heading }}</h2>
  {% endunless %}
  <div class="reelup-carousel {{ layout_class }} {{ shadow_class }} {{ visibility_class }}" data-reelup-story-group style="{{ wrapper_style | strip_newlines | strip }}" {{ block.shopify_attributes }}>
    {% for reel in reels_field.value %}
      {% if reel.published.value and reel.config.value.cloudflareStreamUid != blank and reel.config.value.hlsManifestUrl != blank %}
        {% render 'reel-video-schema', reel: reel %}
        <div
          class="reelup-trigger"
          data-reelup-trigger
          data-reel-id="{{ reel.system.id }}"
          data-hls-src="{{ reel.config.value.hlsManifestUrl | escape }}"
          data-poster-url="{{ reel.config.value.posterUrl | escape }}"
          data-title="{{ reel.title.value | escape }}"
          data-close-label="{{ 'reels.close_label' | t }}"
          data-play-label="{{ 'reels.play_label' | t }}"
          data-pause-label="{{ 'reels.pause_label' | t }}"
          data-shop-label="{{ 'reels.shop_this_video_label' | t }}"
          data-cta-color="{{ widget_style.ctaColor }}"
          data-cta-text-color="{{ widget_style.ctaTextColor | default: '#ffffff' }}"
          data-cta-hover-color="{{ cta_hover_color | strip }}"
          data-cta-label="{{ widget_style.ctaLabel | escape }}"
          data-cta-style="{{ widget_style.ctaStyle | default: 'pill' }}"
          data-show-price="{{ style_show_price }}"
          data-show-title="{{ style_show_title_overlay }}"
          data-show-product-image="{{ widget_style.showProductImage | default: true }}"
          data-tag-reveal-mode="{{ widget_style.tagRevealMode | default: 'always' }}"
          data-muted-default="{{ style_muted_default }}"
          data-loop="{{ style_loop }}"
          data-autoplay-scroll="{{ widget_style.autoplayOnScroll | default: false }}"
        >
          <button
            type="button"
            class="reelup-trigger__button"
            aria-label="{{ 'reels.play_label' | t }}"
          >
            {% if reel.config.value.posterUrl != blank %}
              <img
                class="reelup-trigger__poster"
                src="{{ reel.config.value.posterUrl | escape }}"
                alt="{{ reel.title.value | escape }}"
                loading="lazy"
                width="360"
                height="640"
              >
            {% endif %}
            <span class="reelup-trigger__play-icon" aria-hidden="true"></span>
          </button>
          {% if reel.tagged_products.value.size > 0 %}
            <template data-reelup-products>
              {% for product in reel.tagged_products.value %}
                {% assign variant = product.selected_or_first_available_variant %}
                <div class="reelup-lightbox__product">
                  <a class="reelup-lightbox__product-link" href="{{ product.url }}">
                    {% if product.featured_image %}
                      <img
                        class="reelup-lightbox__product-image"
                        src="{{ product.featured_image | image_url: width: 160 }}"
                        alt="{{ product.title | escape }}"
                        loading="lazy"
                        width="56"
                        height="56"
                      >
                    {% endif %}
                    <span class="reelup-lightbox__product-info">
                      <span class="reelup-lightbox__product-title">{{ product.title }}</span>
                      <span class="reelup-lightbox__product-price">{{ product.price | money }}</span>
                    </span>
                  </a>
                  {% if variant %}
                    <button
                      type="button"
                      class="reelup-lightbox__add-to-cart"
                      data-reelup-add-to-cart
                      data-variant-id="{{ variant.id }}"
                      data-add-label="{{ 'reels.add_to_cart' | t }}"
                      data-added-label="{{ 'reels.added_to_cart' | t }}"
                    >
                      {{ 'reels.add_to_cart' | t }}
                    </button>
                  {% endif %}
                </div>
              {% endfor %}
            </template>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Stacked carousel",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    {
      "type": "paragraph",
      "content": "Appearance, labels, and behavior for this widget are set in the app's Widgets page, not here — open the widget's Appearance tab to customize it."
    }
  ]
}
{% endschema %}
