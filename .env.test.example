# Copy to .env.test (git-ignored). Read by `npm test`, `npm run test:integration`
# and vitest.config.ts. Never point this at production: the integration
# tests delete rows. The URL must use `schema=test` or a local host
# (localhost / 127.0.0.1 / postgres / db) or the run is refused.
#
# Matches docker-compose.test.yml (`docker compose -f docker-compose.test.yml up -d --wait`).
# Change 5432 if you started it with TEST_DB_PORT.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reelup_test?schema=test"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/reelup_test?schema=test"
